{
  "name": "@crvouga/mockingbird-storybook",
  "private": true,
  "type": "module",
  "description": "The Mockingbird UI catalog: every screen, page, section and component of every emulator, admin UI, example app and the docs site, in one Storybook that composes the Fleet Cloud and notifications Storybooks.",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/dev.ts",
    "storybook": "storybook dev -p 6008 --no-open",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "screenshots": "bun scripts/screenshots.ts",
    "verify": "bun scripts/verify.ts",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun scripts/verify.ts --no-build"
  },
