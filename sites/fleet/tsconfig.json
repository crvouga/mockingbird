{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "specs/**/*.ts",
    ".storybook/**/*.ts",
    "playwright.config.ts",
    "src/**/*.tsx",
    "scripts/**/*.tsx",
    "test/**/*.tsx",
    "specs/**/*.tsx",
    ".storybook/**/*.tsx"
  ],
  "exclude": ["dist"]
}
