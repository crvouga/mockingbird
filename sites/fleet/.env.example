# Mockingbird Fleet: every setting is an environment variable. Copy this file to .env, fill in the
# REQUIRED block, and run:  docker run --env-file .env -p 8080:8080 ghcr.io/crvouga/chrisvouga-mockingbird-fleet
# Validate without starting the server:  docker run --rm --env-file .env <image> bun dist/main.js check
# If something is missing or wrong the server exits with code 78 and prints what to set.

# ---- REQUIRED for a real deployment -------------------------------------------------------------
# The https origin people and SDKs will use. (http://localhost:<port> switches to dev mode.)
PUBLIC_URL=https://fleet.example.com

# PostgreSQL 13+. The server creates and uses only the schema DATABASE_SCHEMA (default mockingbird_fleet).
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# Any S3-compatible store with conditional writes (Cloudflare R2, AWS S3). The bucket must exist.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Sign-in: set at least one.
# (a) Simplest. Then create your first user:
#     curl -X POST $PUBLIC_URL/api/v1/admin/users -H "Authorization: Bearer $OPERATOR_TOKEN" \
#          -H 'content-type: application/json' -d '{"email":"you@example.com"}'
#     and paste the returned token into the dashboard's sign-in page.
OPERATOR_TOKEN=            # openssl rand -hex 32
# (b) Single sign-on with any OpenID Connect provider (public client, PKCE, redirect URI <PUBLIC_URL>/auth/callback).
# OIDC_ISSUER=https://<your-identity-provider>/<realm>
# OIDC_CLIENT_ID=

# ---- Behind a proxy or load balancer -----------------------------------------------------------
# Number of trusted proxies in front of the server, so rate limits see real client addresses.
# TRUSTED_PROXY_HOPS=1

# ---- Optional -----------------------------------------------------------------------------------
# PORT=8080
# FLEET_URL=https://fleets.example.com     # serve fleets from a second hostname (stronger isolation)
# DATABASE_SCHEMA=mockingbird_fleet
# S3_PREFIX=mockingbird-fleet
# CORS_ORIGINS=https://app.example.com     # browser apps allowed to call the API with an API key

# Quotas (defaults shown; 0 = unlimited). The operator can override them per organization.
# LIMIT_ORGS_PER_USER=5
# LIMIT_PROJECTS_PER_ORG=20
# LIMIT_FLEETS_PER_ORG=50
# LIMIT_EMULATORS_PER_FLEET=50
# LIMIT_MEMBERS_PER_ORG=50
# LIMIT_API_KEYS_PER_ORG=50
# LIMIT_STATE_BYTES=16777216               # stored (compressed) state per emulator
# LIMIT_REQUESTS_PER_MONTH=1000000         # emulator requests per organization
# LIMIT_FLEET_REQUESTS_PER_MINUTE=3000     # ceiling for any one fleet

# Rate limits and abuse protection (defaults shown; 0 = unlimited).
# RATE_LIMIT_API_PER_MINUTE=600            # control API, per credential
# RATE_LIMIT_AUTH_PER_MINUTE=20            # sign-in attempts and rejected credentials, per address
# RATE_LIMIT_CLIENT_PER_MINUTE=1200        # emulator requests, per client address
# FLEET_MAX_CONCURRENT_REQUESTS=64         # in flight per fleet
# FLEET_REQUEST_TIMEOUT_MS=30000
# FLEET_MAX_INSTANCES=64                   # emulators kept loaded in memory
# FLEET_INSTANCE_IDLE_MS=600000

# OpenTelemetry (OTLP/HTTP JSON). Off unless an endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<collector>
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<token>
# OTEL_SERVICE_NAME=mockingbird-fleet

# Read secrets from Vault / OpenBao KV v2 instead of setting them here (fills only unset variables).
# VAULT_ADDR=https://<vault-host>
# VAULT_TOKEN=
# VAULT_PROJECT=personal
# VAULT_CONFIG=prd
