---
export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteTitle = "Mockingbird Docs";
const fullTitle = title === "Home" ? siteTitle : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || "Mockingbird: Stateful test doubles for APIs"} />
    <title>{fullTitle}</title>
    <style>
      :root {
        --color-text: #1a1a1a;
        --color-bg: #ffffff;
        --color-border: #e5e5e5;
        --color-primary: #0066cc;
        --color-muted: #666666;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial,
          sans-serif;
        --font-mono: "Fira Code", Menlo, "Courier New", monospace;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --color-text: #f5f5f5;
          --color-bg: #0a0a0a;
          --color-border: #333333;
          --color-primary: #3399ff;
          --color-muted: #999999;
        }
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        font-family: var(--font-sans);
        color: var(--color-text);
        background-color: var(--color-bg);
        line-height: 1.6;
      }

      body {
        padding: 20px;
      }

      header {
        border-bottom: 1px solid var(--color-border);
        padding: 20px 0;
        margin-bottom: 40px;
      }

      .header-nav {
        display: flex;
        gap: 20px;
        align-items: center;
      }

      .header-nav a {
        color: var(--color-text);
        text-decoration: none;
        font-size: 14px;
        transition: color 0.2s;
      }

      .header-nav a:hover {
        color: var(--color-primary);
      }

      h1 {
        font-size: 32px;
        margin-bottom: 10px;
      }

      h2 {
        font-size: 24px;
        margin: 30px 0 15px 0;
      }

      h3 {
        font-size: 18px;
        margin: 20px 0 10px 0;
      }

      p {
        margin-bottom: 15px;
      }

      code {
        background-color: rgba(0, 0, 0, 0.05);
        padding: 2px 6px;
        border-radius: 3px;
        font-family: var(--font-mono);
        font-size: 14px;
      }

      @media (prefers-color-scheme: dark) {
        code {
          background-color: rgba(255, 255, 255, 0.1);
        }
      }

      pre {
        background-color: rgba(0, 0, 0, 0.05);
        padding: 15px;
        border-radius: 6px;
        overflow-x: auto;
        margin: 15px 0;
        font-family: var(--font-mono);
        font-size: 13px;
      }

      @media (prefers-color-scheme: dark) {
        pre {
          background-color: rgba(255, 255, 255, 0.05);
        }
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
      }

      th,
      td {
        border: 1px solid var(--color-border);
        padding: 12px;
        text-align: left;
      }

      th {
        background-color: rgba(0, 0, 0, 0.03);
        font-weight: 600;
      }

      @media (prefers-color-scheme: dark) {
        th {
          background-color: rgba(255, 255, 255, 0.05);
        }
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
        transition: opacity 0.2s;
      }

      a:hover {
        opacity: 0.8;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin: 20px 0;
      }

      .card {
        border: 1px solid var(--color-border);
        padding: 20px;
        border-radius: 8px;
        transition: border-color 0.2s;
      }

      .card:hover {
        border-color: var(--color-primary);
      }

      .badge {
        display: inline-block;
        background-color: rgba(0, 102, 204, 0.1);
        color: var(--color-primary);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        margin-right: 8px;
        margin-bottom: 8px;
      }

      footer {
        border-top: 1px solid var(--color-border);
        padding: 20px 0;
        margin-top: 60px;
        font-size: 13px;
        color: var(--color-muted);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <div class="header-nav">
          <a href="/">Mockingbird</a>
          <a href="/services">Services</a>
          <a href="/compatibility">Compatibility</a>
          <a href="https://github.com/crvouga/mockingbird" target="_blank">GitHub</a>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <p>Mockingbird © 2025. MIT License.</p>
      </footer>
    </div>
  </body>
</html>
