---
import catalog from "virtual:mockingbird/catalog"
import { ThemeSwitch } from "@crvouga/mockingbird-ui/react"
import InlineScript from "../components/InlineScript.astro"
import { IDENTITY, MARK_HREF, RISK_DISCLAIMER, SOCIAL_CARD } from "../lib/content.ts"
import { inline } from "../lib/inline.ts"
import { metaDescription } from "../lib/meta.ts"
import { SiteSearch } from "../ui/search.tsx"
import { GithubAction, SiteShell } from "../ui/site-shell.tsx"
import "../styles/app.css"

interface Props {
  title?: string
  description?: string
  /** A markdown twin of this page, advertised to agents with `rel="alternate"`. */
  markdown?: string
  /** Open Graph type: `article` for a guide, `website` for everything else. */
  type?: "website" | "article"
  /** Keep the page out of search results and link previews (the 404, unlisted pages). */
  noindex?: boolean
  /** The address to index when this content is also served elsewhere; defaults to this page's own. */
  canonicalPath?: string
}

const {
  title,
  description:
    copy = `Stateful emulators for ${catalog.totals.services} third-party APIs and SQL databases. Every emulator runs in Node, Bun, browsers, and Workers.`,
  markdown,
  type = "website",
  noindex = false,
  canonicalPath,
} = Astro.props
// Runs before first paint so the page never flashes the wrong theme: the visitor's choice
// (ThemeSwitch, `mb:theme`) pins light or dark; otherwise the page follows the system.
const THEME_SCRIPT = `try {
  var mode = localStorage.getItem("mb:theme")
  if (mode === "light" || mode === "dark") {
    document.documentElement.classList.add(mode)
    document.documentElement.dataset.theme = mode
  }
} catch (e) {}`
const description = metaDescription(copy)
const fullTitle = title
  ? `${title} · Mockingbird`
  : "Mockingbird · Stateful emulators for the APIs you depend on"
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
// Crawlers need absolute URLs, and the same page must not be shared under two addresses.
const canonical = new URL(canonicalPath ?? path, IDENTITY.docs).href
const socialImage = new URL(SOCIAL_CARD.href, IDENTITY.docs).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- iOS turns digit runs in API samples into phone links unless told not to. -->
    <meta name="format-detection" content="telephone=no" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={IDENTITY.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SOCIAL_CARD.width)} />
    <meta property="og:image:height" content={String(SOCIAL_CARD.height)} />
    <meta property="og:image:alt" content={SOCIAL_CARD.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={SOCIAL_CARD.alt} />
    <meta name="theme-color" content="#f6f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={MARK_HREF} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <InlineScript code={THEME_SCRIPT} />
  </head>
  <body class="bg-background text-foreground antialiased">
    <SiteShell path={path} repo={catalog.repo} notice={RISK_DISCLAIMER.enabled ? `⚠️ ${inline(RISK_DISCLAIMER.text)}` : undefined}>
      <Fragment slot="actions">
        <SiteSearch client:load />
        <GithubAction repo={catalog.repo} />
        <ThemeSwitch client:load />
      </Fragment>
      <slot />
    </SiteShell>
    <script>
      import "../client/site.ts"
    </script>
  </body>
</html>
