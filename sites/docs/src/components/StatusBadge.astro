---
export interface Props {
  status: "implemented" | "experimental" | "wip";
}

const { status } = Astro.props;

const statusConfig = {
  implemented: {
    label: "Implemented",
    color: "#009900",
    bgColor: "rgba(0, 153, 0, 0.1)",
  },
  experimental: {
    label: "Experimental",
    color: "#ff9900",
    bgColor: "rgba(255, 153, 0, 0.1)",
  },
  wip: {
    label: "Work in Progress",
    color: "#ff6666",
    bgColor: "rgba(255, 102, 102, 0.1)",
  },
};

const config = statusConfig[status];
---

<span class={`status-badge status-${status}`} style={`--status-color: ${config.color}; --status-bg: ${config.bgColor}`}>
  {config.label}
</span>

<style>
  .status-badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 12px;
    font-weight: 600;
    background-color: var(--status-bg);
    color: var(--status-color);
  }

  .status-wip {
    border: 1px solid var(--status-color);
  }
</style>
