---
/**
 * Interactive Stripe checkout toy app.
 * Demonstrates a complete payment flow: create customer, add payment method, create payment.
 */
---

<div class="stripe-demo">
  <div class="demo-header">
    <h3>Stripe Checkout Flow</h3>
    <span class="demo-badge">Complete payment flow</span>
  </div>

  <div class="demo-layout">
    <div class="demo-form">
      <h4>Checkout</h4>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="demo-email" placeholder="customer@example.com" value="customer@example.com" />
      </div>

      <div class="form-group">
        <label for="amount">Amount (cents)</label>
        <input type="number" id="demo-amount" placeholder="1000" value="1000" />
      </div>

      <button id="demo-checkout" class="btn-primary">→ Process Payment</button>
    </div>

    <div class="demo-output">
      <h4>Results</h4>
      <div id="demo-results" class="results-box">
        <p>Click "Process Payment" to create a customer, add a payment method, and process a charge...</p>
      </div>
    </div>
  </div>

  <div class="demo-note">
    Runs fully in-process: no server, no backend needed. State is in-memory for this demo.
  </div>
</div>

<style>
  .stripe-demo {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.02);
    margin: 20px 0;
  }

  @media (prefers-color-scheme: dark) {
    .stripe-demo {
      background-color: rgba(255, 255, 255, 0.02);
    }
  }

  .demo-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 15px;
    border-bottom: 1px solid var(--color-border);
    background-color: rgba(0, 102, 204, 0.05);
  }

  .demo-header h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .demo-badge {
    display: inline-block;
    background-color: rgba(0, 153, 0, 0.1);
    color: #009900;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: 500;
  }

  .demo-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background-color: var(--color-border);
  }

  @media (max-width: 800px) {
    .demo-layout {
      grid-template-columns: 1fr;
    }
  }

  .demo-form,
  .demo-output {
    padding: 15px;
    background-color: var(--color-bg);
  }

  .demo-form h4,
  .demo-output h4 {
    margin: 0 0 12px 0;
    font-size: 13px;
    font-weight: 600;
  }

  .form-group {
    margin-bottom: 12px;
  }

  .form-group label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 4px;
    color: var(--color-text);
  }

  .form-group input {
    width: 100%;
    padding: 6px 8px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: 13px;
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(0, 102, 204, 0.1);
  }

  .btn-primary {
    width: 100%;
    padding: 8px 12px;
    background-color: #0066cc;
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .btn-primary:hover {
    background-color: #0052a3;
  }

  .btn-primary:active {
    background-color: #003d7a;
  }

  .btn-primary.loading {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .results-box {
    background-color: rgba(0, 0, 0, 0.03);
    border-radius: 4px;
    padding: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-text);
    max-height: 300px;
    overflow-y: auto;
    min-height: 100px;
  }

  @media (prefers-color-scheme: dark) {
    .results-box {
      background-color: rgba(255, 255, 255, 0.03);
    }
  }

  .result-line {
    margin: 2px 0;
    padding: 2px;
  }

  .result-line.success {
    color: #009900;
  }

  .result-line.info {
    color: var(--color-muted);
  }

  .result-line.error {
    color: #ff6666;
  }

  .demo-note {
    padding: 10px 15px;
    background-color: rgba(0, 102, 204, 0.05);
    border-top: 1px solid var(--color-border);
    font-size: 12px;
    color: var(--color-muted);
  }
</style>

<script>
  const emailInput = document.getElementById("demo-email");
  const amountInput = document.getElementById("demo-amount");
  const checkoutBtn = document.getElementById("demo-checkout");
  const resultsBox = document.getElementById("demo-results");

  // Mock state
  const mockState = {
    customers: {},
    charges: {},
    nextId: 1000,
  };

  function addResult(message, type = "info") {
    const line = document.createElement("div");
    line.className = `result-line ${type}`;
    line.textContent = message;
    resultsBox.appendChild(line);
  }

  function clearResults() {
    resultsBox.innerHTML = "";
  }

  checkoutBtn.addEventListener("click", async () => {
    const email = emailInput.value;
    const amount = parseInt(amountInput.value);

    if (!email || !amount) {
      addResult("✗ Email and amount required", "error");
      return;
    }

    clearResults();
    checkoutBtn.disabled = true;
    checkoutBtn.classList.add("loading");

    try {
      addResult("1. Creating customer...", "info");
      const customerId = `cus_${mockState.nextId++}`;
      mockState.customers[customerId] = {
        id: customerId,
        email,
        created: new Date().toISOString(),
      };
      addResult(`   ✓ Customer created: ${customerId}`, "success");

      addResult("2. Adding payment method...", "info");
      const pmId = `pm_${mockState.nextId++}`;
      addResult(`   ✓ Payment method attached: ${pmId}`, "success");

      addResult("3. Creating charge...", "info");
      const chargeId = `ch_${mockState.nextId++}`;
      mockState.charges[chargeId] = {
        id: chargeId,
        customer: customerId,
        amount,
        currency: "usd",
        status: "succeeded",
        created: new Date().toISOString(),
      };
      addResult(`   ✓ Charge succeeded: ${chargeId}`, "success");

      addResult("", "info");
      addResult("✓ Payment processed successfully", "success");
      addResult(`   Amount: $${(amount / 100).toFixed(2)} USD`, "success");
      addResult(`   Customer: ${email}`, "success");
    } catch (error) {
      addResult(`✗ Error: ${error.message}`, "error");
    } finally {
      checkoutBtn.disabled = false;
      checkoutBtn.classList.remove("loading");
    }
  });
</script>
