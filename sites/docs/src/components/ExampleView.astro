---
import { ExampleView } from "../ui/examples/example-view.tsx"

interface Props {
  title: string
  /** Apps fill the view; panel examples keep a small inset. */
  fit?: "app" | "panel"
}
const { title, fit = "panel" } = Astro.props
---

<ExampleView title={title} fit={fit} titleId={`example-view-${crypto.randomUUID()}`} />
