---
import { Monogram } from "../ui/primitives.tsx"

interface Props {
  name: string
  hue?: number
  size?: number
  /** The vendor's logo; the initials are the fallback. */
  logo?: string | null
}
const { name, size = 40, logo = null } = Astro.props
---

<Monogram name={name} logo={logo} size={size <= 32 ? "sm" : size >= 48 ? "lg" : "md"} />
