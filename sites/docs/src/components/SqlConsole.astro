---
import { SQL_SNIPPETS } from "../lib/sql.ts"
import type { Service } from "../lib/types.ts"
import { SqlConsole } from "../ui/service/sql-console.tsx"

interface Props {
  service: Service
}
const { service: s } = Astro.props
const snippets = SQL_SNIPPETS[s.name === "postgres" ? "postgres" : "sqlite"]
---

<SqlConsole client:visible service={s.name} packageName={s.packageName} snippets={snippets} />
