---
/**
 * Landing figure: the lab testing example, whose client, server, and every vendor it calls share
 * one browser tab. The launch button mounts that app (`client/appExamples.ts`), so the page that
 * includes this component must load that script.
 */
import catalog from "virtual:mockingbird/catalog"
import { APP_EXAMPLES } from "../../lib/appExamples.ts"
import { IDENTITY } from "../../lib/content.ts"
import ExampleView from "../ExampleView.astro"
import Icon from "../Icon.astro"
import VendorLogo from "./VendorLogo.astro"

const example = APP_EXAMPLES.find((e) => e.slug === "medical-testing")
if (!example) throw new Error("medical-testing is missing from APP_EXAMPLES")

/** What each vendor does for the app. The OAuth emulator's brand is the OpenID Foundation; name the protocol. */
const ROLES: Record<string, { name?: string; role: string }> = {
  oauth: { name: "OAuth", role: "Google & Apple sign-in" },
  stripe: { role: "Payments" },
  junction: { role: "Lab results" },
  twilio: { role: "SMS" },
  resend: { role: "Email" },
  fcm: { role: "Push" },
  postgres: { role: "Database" },
}
const vendors = example.servicesUsed.map((name) => {
  const service = catalog.services.find((s) => s.name === name)
  if (!service) throw new Error(`${example.slug} uses ${name}, which is not in the catalog`)
  const known = ROLES[name]
  return {
    service,
    name: known?.name ?? service.brand.vendor,
    role: known?.role ?? service.displayName,
  }
})

const modes = [
  ["Run it", "in this tab, with nothing to install"],
  ["Serve it", "with `bun run dev` behind a real port"],
  ["Test it", "with `bun test`, routes driven in-process"],
]
---

<app-example data-example={example.slug} class="stack">
  <figure class="browser" aria-label={`${example.title}: client, server, and ${vendors.length} vendors in one browser tab`}>
    <div class="chrome" aria-hidden="true">
      <span class="mark"></span>
      <span class="url">{new URL(IDENTITY.docs).host}/examples/{example.slug}</span>
    </div>

    <div class="body">
      <div class="app">
        <div class="layer">
          <span class="kicker">Client</span>
          <strong>Lab workspace UI</strong>
        </div>
        <span class="link" aria-hidden="true"></span>
        <div class="layer">
          <span class="kicker">Server</span>
          <strong>HTTP API</strong>
        </div>
      </div>

      <ul class="vendors">
        {
          vendors.map(({ service, name, role }) => (
            <li>
              <VendorLogo service={service} size={44} />
              <span class="vendor-name">{name}</span>
              <span class="vendor-role">{role}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <figcaption>Everything above runs in this tab. No request leaves it.</figcaption>
  </figure>

  <div class="side">
    <ul class="modes">
      {
        modes.map(([verb, rest]) => (
          <li>
            <strong>{verb}</strong>{" "}
            <span set:html={(rest as string).replace(/`([^`]+)`/g, "<code>$1</code>")} />
          </li>
        ))
      }
    </ul>
    <div class="actions">
      <button type="button" class="btn btn-primary" data-example-open aria-haspopup="dialog">
        <Icon name="play" /> Launch the app
      </button>
      <a class="btn btn-secondary" href={`/examples/${example.slug}`}>How it's built</a>
    </div>
  </div>

  <ExampleView title={example.title} fit="app" />
</app-example>

<style>
  .stack {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }

  .browser {
    margin: 0;
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 44px;
    padding: 0 14px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .mark::before {
    content: ">_";
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .url {
    flex: 1;
    min-width: 0;
    padding: 5px 12px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .body {
    display: grid;
    gap: 36px;
    padding: 36px 32px;
  }

  .app {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr);
    align-items: center;
  }

  .layer {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .kicker {
    color: var(--highlight);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .layer strong {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
  }

  .link {
    height: 0;
    border-top: 1px solid var(--fg);
  }

  /* The server's line drops to a rail that every vendor hangs from. */
  .app .layer:last-child::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    height: 18px;
    border-left: 1px solid var(--border-strong);
  }

  .vendors {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vendors::before {
    content: "";
    position: absolute;
    left: 12.5%;
    right: 12.5%;
    top: -18px;
    border-top: 1px solid var(--border-strong);
  }

  .vendors li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 2px;
    text-align: center;
  }

  .vendors li::before {
    content: "";
    position: absolute;
    top: -18px;
    height: 18px;
    border-left: 1px solid var(--border-strong);
  }

  .vendor-name {
    margin-top: 8px;
    font-size: 13.5px;
    font-weight: 600;
  }

  .vendor-role {
    color: var(--fg-subtle);
    font-size: 12.5px;
  }

  figcaption {
    padding: 14px 32px;
    border-top: 1px solid var(--border);
    color: var(--highlight);
    font-family: var(--font-display);
    font-style: normal;
    font-size: 15px;
  }

  .side {
    display: grid;
    gap: 28px;
  }

  .modes {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .modes li {
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 15px;
  }

  .modes li:first-child {
    border-top: 1px solid var(--border);
  }

  .modes strong {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
  }

  .modes :global(code) {
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-muted);
    font-family: var(--font-mono);
    font-size: 0.82em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 960px) {
    .stack {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 560px) {
    .body {
      padding: 24px 18px;
    }
    .app {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .link,
    .app .layer:last-child::after,
    .vendors::before,
    .vendors li::before {
      display: none;
    }
    .vendors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 12px;
    }
    figcaption {
      padding: 14px 18px;
    }
  }
</style>
