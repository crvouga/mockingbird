---
import type { Service } from "../lib/types.ts"
import ExampleLauncher from "./ExampleLauncher.astro"

interface Props {
  service: Service
}
const { service } = Astro.props
---
{service.examples.map(example => (
  <section id={`example-${example.id}`} class="service-example">
    <header><span class="example-label">Interactive example</span><h2>{example.title}</h2><p>{example.description}</p></header>
    <ExampleLauncher element="service-example" example={example.key} title={example.title} />
    <details class="example-source"><summary>Explore the example source</summary>
      {example.sources.map(source => (<details><summary><code>{source.path}</code></summary><div class="prose" set:html={source.html} /></details>))}
    </details>
  </section>
))}
<script>
  import "../client/examples.ts"
</script>
<style>
  .service-example{padding-top:48px;min-width:0}
  .example-label{text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:650;color:var(--accent-soft-fg)}
  h2{margin-top:8px;font-size:24px;letter-spacing:-.03em}
  header p{margin-top:8px;margin-bottom:20px;color:var(--fg-muted);font-size:14.5px;max-width:720px}
  service-example{display:block;min-width:0}
  .example-source{margin-top:16px;border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;font-size:13px}
  summary{cursor:pointer;min-height:24px}
  .example-source details{margin-top:12px;padding-top:12px;border-top:1px solid var(--border)}
  .prose{margin-top:10px;font-size:12px;max-width:100%}
</style>
