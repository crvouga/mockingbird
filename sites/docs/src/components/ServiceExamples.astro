---
import type { Service } from "../lib/types.ts"
import { ExampleSources } from "../ui/examples/example-sources.tsx"
import { Section } from "../ui/primitives.tsx"
import ExampleLauncher from "./ExampleLauncher.astro"

interface Props {
  service: Service
}
const { service } = Astro.props
---

{
  service.examples.map((example) => (
    <Section id={`example-${example.id}`} eyebrow="Interactive example" title={example.title} description={example.description}>
      <ExampleLauncher element="service-example" example={example.key} title={example.title} />
      <ExampleSources sources={example.sources.map(({ path, html }) => ({ path, html }))} />
    </Section>
  ))
}
<script>
  import "../client/examples.ts"
</script>
