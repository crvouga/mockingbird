---
// client:load, not client:visible: a `?op=` link and the operations table's "Try" buttons need it before it is on screen.
import type { Service } from "../lib/types.ts"
import { Playground } from "../ui/service/playground.tsx"

interface Props {
  service: Service
}
const { service: s } = Astro.props
---

<Playground
  client:load
  service={s.name}
  packageName={s.packageName}
  origin={s.origin}
  operation={s.playground.operation}
  operations={s.operations.filter((o) => o.supported)}
  authHint={s.playground.authHint}
/>
