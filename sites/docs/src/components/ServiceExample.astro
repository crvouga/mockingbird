---
export interface Props {
  code: string;
  description: string;
  serviceName: string;
}

const { code, description, serviceName } = Astro.props;
const encodedCode = encodeURIComponent(code);
---

<div class="example-container">
  <div class="example-header">
    <h4>Live Example</h4>
    <span class="example-desc">{description}</span>
  </div>

  <div class="code-block">
    <pre><code>{code}</code></pre>
  </div>

  <div class="example-actions">
    <button class="btn copy-btn" data-code={code} title="Copy code to clipboard">
      Copy
    </button>
    <a
      href={`https://runkit.com/?source=${encodedCode}`}
      target="_blank"
      rel="noopener"
      class="btn try-btn"
      title="Try in RunKit"
    >
      Try in RunKit
    </a>
    <a
      href="#install"
      class="btn install-btn"
      title="Installation instructions"
    >
      Install
    </a>
  </div>

  <p class="example-note">
    <strong>Isomorphic:</strong> This mock runs in Node, Bun, browsers, and Workers.
    <a href="https://github.com/crvouga/mockingbird#using-mockingbird-in-your-project" target="_blank">See all surfaces</a>.
  </p>
</div>

<style>
  .example-container {
    margin: 20px 0;
    padding: 15px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.02);
  }

  @media (prefers-color-scheme: dark) {
    .example-container {
      background-color: rgba(255, 255, 255, 0.02);
    }
  }

  .example-header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 12px;
  }

  .example-header h4 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }

  .example-desc {
    font-size: 12px;
    color: var(--color-muted);
    font-style: italic;
  }

  .code-block {
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 6px;
    overflow-x: auto;
    margin: 12px 0;
  }

  @media (prefers-color-scheme: dark) {
    .code-block {
      background-color: rgba(255, 255, 255, 0.05);
    }
  }

  .code-block pre {
    margin: 0;
    padding: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.4;
  }

  .code-block code {
    background: none;
    padding: 0;
    color: var(--color-text);
  }

  .example-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0;
  }

  .btn {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    background-color: transparent;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn:hover {
    background-color: var(--color-primary);
    color: var(--color-bg);
  }

  .btn.copy-btn.copied {
    background-color: #009900;
    border-color: #009900;
    color: white;
  }

  .example-note {
    font-size: 12px;
    color: var(--color-muted);
    margin: 12px 0 0 0;
    padding: 8px;
    background-color: rgba(0, 102, 204, 0.05);
    border-radius: 4px;
  }

  .example-note a {
    color: var(--color-primary);
  }
</style>

<script>
  // Copy to clipboard functionality
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      const code = (e.target as HTMLElement).getAttribute("data-code");
      if (code) {
        try {
          await navigator.clipboard.writeText(code);
          const btn = e.target as HTMLElement;
          const original = btn.textContent;
          btn.textContent = "Copied!";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove("copied");
          }, 2000);
        } catch (err) {
          console.error("Failed to copy:", err);
        }
      }
    });
  });
</script>
