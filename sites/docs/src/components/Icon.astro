---
interface Props {
  name: string
  class?: string
  label?: string
}
const { name, class: className, label } = Astro.props
---

<svg class:list={["i", `i-${name}`, className]} aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label}>
  <use href={`#i-${name}`}></use>
</svg>
