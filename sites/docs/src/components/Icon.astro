---
// The React icon (src/ui/icon.tsx), for the few Astro components that draw one themselves.
import { Icon as ReactIcon } from "../ui/icon.tsx"

interface Props {
  name: string
  class?: string
  label?: string
}
const { name, class: className, label } = Astro.props
---

<ReactIcon name={name} className={className ?? "size-4"} label={label} />
