---
import catalog from "virtual:mockingbird/catalog"
import { QUICK_START } from "../lib/content.ts"
import Icon from "./Icon.astro"
import Install from "./Install.astro"

const { steps } = catalog.quickStart
---

<div class="checkout">
  <div class="checkout-install"><Install pkg={QUICK_START.packages.join(" ")} /></div>
  <div class="window" data-code-tabs>
    <div class="checkout-tabs" role="tablist" aria-label="Checkout quick start">
      {steps.map((step, i) => (
        <button type="button" role="tab" id={`checkout-tab-${step.id}`} aria-controls={`checkout-panel-${step.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-code-tab={step.id}>
          <span class="step-number">0{i + 1}</span> {step.title}
          {i < steps.length - 1 && <Icon name="arrow-right" />}
        </button>
      ))}
    </div>
    {steps.map((step, i) => (
      <div role="tabpanel" id={`checkout-panel-${step.id}`} aria-labelledby={`checkout-tab-${step.id}`} data-code-panel={step.id} hidden={i !== 0} tabindex="0">
        <div class="window-bar"><Icon name="file" /><span class="window-title">{step.file}</span><span class="badge">TypeScript</span></div>
        <p class="step-description">{step.description}</p>
        <Fragment set:html={step.html} />
      </div>
    ))}
    <div class="checkout-result"><Icon name="check" /><code>201 Created</code><span>Payment confirmed. Order saved.</span><span class="badge badge-ok">Zero network requests</span></div>
  </div>
  <p class="checkout-run">Save all three files next to the <code>{QUICK_START.sdk}</code> SDK your app already has, then run <code>bun client.ts</code> or <code>npx tsx client.ts</code>. <a href="/docs/getting-started#build-a-checkout">Follow the walkthrough <Icon name="arrow-right" /></a></p>
</div>

<script>
  import "../client/codeTabs.ts"
</script>

<style>
  .checkout-install { margin-bottom: 16px; max-width: 900px; }
  .checkout-tabs { display: flex; border-bottom: 1px solid var(--border); background: var(--bg-subtle); }
  .checkout-tabs button { display: flex; align-items: center; gap: 10px; padding: 16px 22px; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; background: transparent; color: var(--fg-subtle); font: 600 14px var(--font-sans); cursor: pointer; }
  .checkout-tabs button[aria-selected="true"] { border-bottom-color: var(--accent); background: var(--bg-elevated); color: var(--fg); }
  .checkout-tabs button:hover { color: var(--fg); }
  .step-number { font: 11px var(--font-mono); color: var(--fg-subtle); }
  .checkout-tabs :global(.i) { width: 14px; height: 14px; margin-left: 14px; color: var(--fg-faint); }
  .window-bar { background: transparent; border: 0; padding: 18px 20px 0; }
  .window-bar .badge { margin-left: auto; }
  .step-description { padding: 10px 20px 16px; color: var(--fg-muted); font-size: 13px; }
  [role="tabpanel"] :global(.code) { margin: 0; border: 0; border-radius: 0; background: var(--bg-inset); }
  [role="tabpanel"] :global(.code figcaption) { height: 0; position: relative; border: 0; }
  [role="tabpanel"] :global(figcaption > span) { display: none; }
  [role="tabpanel"] :global(.copy) { position: absolute; right: 8px; top: 8px; background: var(--bg-inset); }
  [role="tabpanel"] :global(pre) { padding: 20px; padding-right: 48px; }
  .checkout-result { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; border-top: 1px solid var(--border); padding: 14px 20px; font-size: 12px; color: var(--fg-muted); }
  .checkout-result > :global(.i) { color: var(--ok); width: 15px; height: 15px; }
  .checkout-result code { color: var(--fg); }
  .checkout-result .badge { margin-left: auto; }
  .checkout-run { margin-top: 14px; font-size: 12px; color: var(--fg-subtle); line-height: 1.8; }
  .checkout-run a { display: inline-flex; align-items: center; gap: 5px; color: var(--highlight); margin-left: 8px; }
  .checkout-run :global(.i) { width: 12px; height: 12px; }
  @media (max-width: 560px) {
    .checkout-tabs button { flex: 1; justify-content: center; padding: 14px 10px; gap: 6px; }
    .checkout-tabs :global(.i) { display: none; }
    .checkout-result .badge { margin-left: 0; }
  }
</style>
