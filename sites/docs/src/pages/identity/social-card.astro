---
// The drawing behind `SOCIAL_CARD`. Link previews need a raster, so this page is the source and
// `public/identity/social-card.png` is a 1200×630 screenshot of it (see docs/DESIGN.md).
// X overlays the page title on the bottom-left corner of the card: keep that corner empty.
import { HEADLINE, IDENTITY, MARK_HREF, SOCIAL_CARD } from "../../lib/content.ts"

const host = new URL(IDENTITY.docs).host
const [summary] = IDENTITY.note.split(". ")
const runtimes = ["Node.js", "Bun", "Browser", "Workers"]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Social card · Mockingbird</title>
    <link rel="icon" type="image/svg+xml" href={MARK_HREF} />
  </head>
  <body>
    <main class="card" style={`width:${SOCIAL_CARD.width}px;height:${SOCIAL_CARD.height}px`}>
      <header>
        <span class="brand"><span class="mark">{IDENTITY.icon}</span>{IDENTITY.name}</span>
        <span class="host">{host}</span>
      </header>
      <div class="copy">
        <p class="eyebrow">API &amp; database emulation</p>
        <h1>{HEADLINE.lead}<br /><span>{HEADLINE.accent}</span></h1>
        <p class="summary">{summary}.</p>
      </div>
      <ul>{runtimes.map((runtime) => <li>{runtime}</li>)}</ul>
    </main>
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    background: #010409;
  }

  .card {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: 64px 80px;
    overflow: hidden;
    background: #0d1117;
    color: #ffffff;
    font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .mark {
    font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
    font-size: 52px;
    line-height: 1;
  }

  .host,
  .eyebrow,
  li {
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
  }

  .host {
    color: #8b949e;
    font-size: 22px;
  }

  .copy {
    margin-block: auto;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 22px;
    color: #9da7b3;
    font-size: 20px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: "";
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #4ade80;
  }

  h1 {
    margin: 0;
    font-size: 96px;
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  h1 span {
    color: #58a6ff;
  }

  .summary {
    margin: 26px 0 0;
    color: #c9d1d9;
    font-size: 27px;
    line-height: 1.35;
    white-space: nowrap;
  }

  /* Right-aligned: the bottom-left corner belongs to X's title overlay. */
  ul {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 7px 14px;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #c9d1d9;
    font-size: 19px;
  }
</style>
