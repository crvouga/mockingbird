---
// The drawing behind `SOCIAL_CARD`. Link previews need a raster, so this page is the source and
// `public/identity/social-card.png` is a 1200×630 screenshot of it (see docs/DESIGN.md).
import { HEADLINE, IDENTITY, MARK_HREF, SOCIAL_CARD } from "../../lib/content.ts"
import { SocialCard } from "../../ui/social-card.tsx"
import "../../styles/app.css"

const [summary] = IDENTITY.note.split(". ")
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Social card · Mockingbird</title>
    <link rel="icon" type="image/svg+xml" href={MARK_HREF} />
  </head>
  <body class="m-0 bg-background">
    <SocialCard
      width={SOCIAL_CARD.width}
      height={SOCIAL_CARD.height}
      host={new URL(IDENTITY.docs).host}
      lead={HEADLINE.lead}
      accent={HEADLINE.accent}
      summary={`${summary}.`}
      runtimes={["Node.js", "Bun", "Browser", "Workers"]}
    />
  </body>
</html>
