---
import catalog from "virtual:mockingbird/catalog"
import { PageHeader } from "@crvouga/mockingbird-ui/react"
import Base from "../layouts/Base.astro"
import { CATEGORIES, type CategorySlug } from "../lib/categories.ts"
import { CoverageLegend, type CoverageRow, CoverageTable } from "../ui/coverage.tsx"

const { services, totals } = catalog
const rows: CoverageRow[] = services.map((s) => ({
  name: s.name,
  displayName: s.displayName,
  logo: s.brand.logo,
  parity: s.parity,
  category: CATEGORIES[s.category as CategorySlug].label,
  kind: s.kind,
  opsSupported: s.opsSupported,
  opsTotal: s.opsTotal,
  inProcess: s.surfaces.inProcess,
  server: s.surfaces.server,
  cli: Boolean(s.surfaces.cli),
}))
---

<Base title="Coverage" description="Operations emulated and surfaces shipped by every Mockingbird service, computed from the packages at build time.">
  <PageHeader
    title="Coverage"
    description={`${totals.services} emulators. Each one declares its own parity, and every emulator is isomorphic: the same package runs in the browser, in a worker, and on a server. Across all of them, ${totals.opsSupported} of ${totals.opsTotal} contract operations are emulated, computed from each package at build time. Click a column to sort.`}
  />
  <CoverageTable client:load rows={rows} />
  <CoverageLegend />
</Base>
