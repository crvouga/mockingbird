---
import catalog from "virtual:mockingbird/catalog"
import InlineScript from "../../components/InlineScript.astro"
import Install from "../../components/Install.astro"
import Playground from "../../components/Playground.astro"
import ServiceExamples from "../../components/ServiceExamples.astro"
import SqlConsole from "../../components/SqlConsole.astro"
import Base from "../../layouts/Base.astro"
import { FLEET } from "../../lib/content.ts"
import type { Service } from "../../lib/types.ts"
import { Pager, Section, TextLink } from "../../ui/primitives.tsx"
import { Prose } from "../../ui/prose.tsx"
import { Operations, ServiceHeader, ServiceLayout } from "../../ui/service/service-page.tsx"

export function getStaticPaths() {
  return catalog.services.map((service, i) => ({
    params: { name: service.name },
    props: {
      service,
      prev: catalog.services[i - 1] ?? null,
      next: catalog.services[i + 1] ?? null,
    },
  }))
}

interface Props {
  service: Service
  prev: Service | null
  next: Service | null
}

const { service: s, prev, next } = Astro.props
const toc = [
  ...s.examples.map((e) => ({ depth: 2, slug: `example-${e.id}`, text: e.title })),
  ...(s.kind !== "node" ? [{ depth: 2, slug: "playground", text: "Playground" }] : []),
  ...(s.opsTotal > 0 ? [{ depth: 2, slug: "operations", text: "Operations" }] : []),
  { depth: 2, slug: "docs", text: "Documentation" },
  ...s.readme.toc.map((t) => ({ ...t, depth: t.depth + 1 })),
]
// Remembers this service in the header's recently viewed list.
const RECENT_SCRIPT = `try {
  var name = document.currentScript.dataset.service
  var recent = JSON.parse(localStorage.getItem("mb:recent") || "[]").filter(function (n) { return n !== name })
  recent.unshift(name)
  localStorage.setItem("mb:recent", JSON.stringify(recent.slice(0, 5)))
} catch (e) {}`
---

<Base title={`${s.displayName} emulator`} description={s.description} markdown={`/services/${s.name}.md`}>
  <InlineScript code={RECENT_SCRIPT} data-service={s.name} />
  <ServiceHeader service={s} fleet={{ package: FLEET.package, configFile: FLEET.configFile }}>
    <Install slot="install" pkg={s.packageName} />
  </ServiceHeader>
  <ServiceLayout toc={toc}>
    <ServiceExamples service={s} />
    {
      s.kind === "http" && (
        <Section
          id="playground"
          title="Playground"
          description="Requests go to the real emulator running in this tab. State persists across requests, and the journal shows what it received. A green dot marks operations whose sample succeeds as-is; others need ids from earlier responses."
        >
          <Playground service={s} />
        </Section>
      )
    }
    {
      s.kind === "sql" && (
        <Section
          id="playground"
          title="Playground"
          description="A SQL console on the real engine, running in this tab. Run the snippets in order, or write your own."
        >
          <SqlConsole service={s} />
        </Section>
      )
    }
    {s.opsTotal > 0 && <Operations service={s} />}
    <Section id="docs" title="Documentation">
      <p slot="description">
        The package README, the same file that ships in the npm tarball.{" "}
        <TextLink href={s.links.readme} external>Edit on GitHub</TextLink>
      </p>
      <Prose html={s.readme.html} as="article" className="[&_:not(pre)>code]:[overflow-wrap:anywhere]" />
    </Section>
    <Pager
      label="Other services"
      previous={prev ? { href: `/services/${prev.name}`, title: prev.displayName } : null}
      next={next ? { href: `/services/${next.name}`, title: next.displayName } : null}
    />
  </ServiceLayout>
</Base>

<script>
  import "../../client/toc.ts"
</script>
