---
import catalog from "virtual:mockingbird/catalog"
import { PageHeader } from "@crvouga/mockingbird-ui/react"
import Base from "../../layouts/Base.astro"
import { CATEGORIES, type CategorySlug } from "../../lib/categories.ts"
import { Catalog, type CatalogEntry } from "../../ui/catalog.tsx"
import { summarize } from "../../ui/service-card.tsx"

const { services, categories, totals } = catalog
const entries: CatalogEntry[] = [...services]
  .sort(
    (a, b) => Number(b.featured) - Number(a.featured) || a.displayName.localeCompare(b.displayName),
  )
  .map((s) => ({
    ...summarize(s),
    text: [
      s.packageName,
      s.brand.vendor,
      s.description,
      CATEGORIES[s.category as CategorySlug].label,
      s.parity,
      s.featured ? "featured" : "",
      ...s.keywords,
      ...s.operations.map((o) => o.id),
    ].join(" "),
  }))
---

<Base title="Emulators" description={`Search and filter ${totals.services} stateful emulators by category. Every emulator runs in the browser, in a worker, and on a server.`}>
  <PageHeader
    eyebrow="Emulator catalog"
    title="Emulators"
    description={`${totals.services} stateful emulators. Each one declares the parity it keeps with its vendor. Every emulator is isomorphic: the same package runs in the browser, in a worker, and on a server. Open one for a live playground backed by the real package.`}
  />
  <Catalog
    client:load
    services={entries}
    categories={categories.map((c) => ({ slug: c.slug, label: c.label, count: c.count }))}
  />
</Base>
