---
import catalog from "virtual:mockingbird/catalog"
import Base from "../../layouts/Base.astro"
import { APP_EXAMPLES } from "../../lib/appExamples.ts"
import { ExamplesIndex, type ServiceRef } from "../../ui/examples/examples.tsx"

const services: Record<string, ServiceRef> = Object.fromEntries(
  catalog.services.map((s) => [s.name, { name: s.name, displayName: s.displayName }]),
)
---

<Base
  title="Examples"
  description="Full-stack demo apps built entirely on Mockingbird emulators — client, server and database, one process, no real network."
>
  <ExamplesIndex examples={APP_EXAMPLES} services={services} repo={catalog.repo} />
</Base>
