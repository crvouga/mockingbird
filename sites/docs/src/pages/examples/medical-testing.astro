---
import catalog from "virtual:mockingbird/catalog"
import { highlightSource } from "../../../integrations/catalog/markdown.ts"
import ExampleLauncher from "../../components/ExampleLauncher.astro"
import Base from "../../layouts/Base.astro"
import { APP_EXAMPLES } from "../../lib/appExamples.ts"
import {
  MedicalTestingCapabilities,
  MedicalTestingHowTo,
  MedicalTestingIntro,
  RunLocally,
  type ServiceRef,
} from "../../ui/examples/examples.tsx"

const example = APP_EXAMPLES.find((e) => e.slug === "medical-testing")
if (!example) throw new Error("medical-testing is missing from APP_EXAMPLES")

const services: Record<string, ServiceRef> = Object.fromEntries(
  catalog.services.map((s) => [s.name, { name: s.name, displayName: s.displayName }]),
)
const runHtml = await highlightSource(example.runCommand, "bash")
---

<Base title={example.title} description={example.description}>
  <MedicalTestingIntro example={example} services={services} />
  <MedicalTestingCapabilities />
  <MedicalTestingHowTo />
  <ExampleLauncher element="app-example" example={example.slug} title={example.title} launchLabel="Launch the app" fit="app" />
  <RunLocally runHtml={runHtml} source={`${catalog.repo}/tree/main/${example.packagePath}`} />
</Base>

<script>
  import "../../client/appExamples.ts"
</script>
