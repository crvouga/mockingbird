---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllServices } from "../lib/data";
import StatusBadge from "../components/StatusBadge.astro";

const services = await getAllServices();
---

<BaseLayout
  title="Services"
  description="Complete catalog of Mockingbird services"
>
  <h1>Services</h1>
  <p style="color: var(--color-text-secondary); font-size: 16px; max-width: 600px;">
    {services.length} production-ready mocks covering payments, healthcare, shipping, analytics, and more.
    All stateful, all isomorphic, all verified against real providers.
  </p>

  <style>
    .services-section {
      padding: 40px 0;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 24px;
      margin: 40px 0;
    }

    .service-card {
      border: 1px solid var(--color-border);
      border-radius: 12px;
      padding: 28px;
      background-color: var(--color-bg);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .service-card:hover {
      border-color: var(--color-primary);
      box-shadow: var(--shadow-lg);
      transform: translateY(-4px);
    }

    .service-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      margin-bottom: 12px;
      gap: 12px;
    }

    .service-name {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 0;
      color: var(--color-text);
    }

    .service-card a {
      color: var(--color-primary);
      font-weight: 700;
    }

    .service-desc {
      font-size: 14px;
      color: var(--color-text-secondary);
      margin: 16px 0;
      line-height: 1.6;
      flex-grow: 1;
    }

    .service-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 16px 0;
      padding: 16px 0;
      border-top: 1px solid var(--color-border-light);
      border-bottom: 1px solid var(--color-border-light);
    }

    .badge {
      display: inline-block;
      background-color: var(--color-primary-lightest);
      color: var(--color-primary);
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge.runtime {
      background-color: rgba(0, 168, 84, 0.1);
      color: var(--color-success);
    }

    .service-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 16px;
    }

    .service-links a {
      font-size: 12px;
      font-weight: 600;
      color: var(--color-primary);
      transition: all 0.2s;
    }

    .service-links a:hover {
      color: var(--color-primary-dark);
    }
  </style>

  <div class="services-section">
    <div class="services-grid">
      {services.map((service) => (
        <div class="service-card">
          <div class="service-header">
            <div>
              <div class="service-name">
                <a href={`/service/${service.name}`}>{service.name}</a>
              </div>
            </div>
            <div>
              <StatusBadge status={service.status} />
            </div>
          </div>

          <div class="service-desc">
            {service.description.substring(0, 160)}
            {service.description.length > 160 ? "..." : ""}
          </div>

          <div class="service-meta">
            {service.surfaces.map((surface) => (
              <span class="badge">{surface}</span>
            ))}
            <span class="badge runtime">{service.runtime}</span>
          </div>

          <div class="service-links">
            <a href={service.npmUrl} target="_blank" rel="noopener">📦 npm</a>
            <a href={service.readmeUrl} target="_blank" rel="noopener">📖 README</a>
            {service.supportUrl && (
              <a href={service.supportUrl} target="_blank" rel="noopener">💬 SUPPORT</a>
            )}
            <a href={service.repoUrl} target="_blank" rel="noopener">🔗 repo</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
