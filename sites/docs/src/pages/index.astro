---
import catalog from "virtual:mockingbird/catalog"
import { highlightSource } from "../../integrations/catalog/markdown.ts"
import ControlDirectory from "../components/ControlDirectory.astro"
import ExampleView from "../components/ExampleView.astro"
import Install from "../components/Install.astro"
import Base from "../layouts/Base.astro"
import { APP_EXAMPLES } from "../lib/appExamples.ts"
import {
  ADMIN_CONTROLS,
  AGENTS,
  CONTRACT,
  FEATURES,
  FLEET,
  HEADLINE,
  IDENTITY,
  NOTIFICATIONS,
  PITCH,
  QUICK_START,
} from "../lib/content.ts"
import { guideSlug } from "../lib/guides.ts"
import { inline } from "../lib/inline.ts"
import { BeforeAfter } from "../ui/landing/before-after.tsx"
import { BrowserStack } from "../ui/landing/browser-stack.tsx"
import {
  AgentDocs,
  Callout,
  Categories,
  CodePanels,
  ContractTable,
  Devices,
  FeaturedHeader,
  FeatureGrid,
  FleetSteps,
  Hero,
  Stats,
} from "../ui/landing/landing.tsx"
import { NotificationsDemo } from "../ui/landing/notifications-demo.tsx"
import { QuickStartTabs } from "../ui/landing/quick-start.tsx"
import { ButtonLink, Html, Section, TextLink } from "../ui/primitives.tsx"
import { ServiceGrid, summarize } from "../ui/service-card.tsx"

const { totals } = catalog
const featured = catalog.services.filter((s) => s.featured).map(summarize)
const fleetConfigHtml = await highlightSource(FLEET.config, "json")
const fleetServeHtml = await highlightSource(FLEET.serve, "bash")
const fleetControlHtml = await highlightSource(FLEET.control, "bash")
const carriers = await Promise.all(
  ADMIN_CONTROLS.carriers.map(async (carrier) => ({
    label: carrier.label,
    file: carrier.file,
    icon: "terminal" as const,
    html: await highlightSource(carrier.code, carrier.lang),
    ariaLabel: `Admin controls: ${carrier.label}`,
  })),
)
const notificationCarriers = await Promise.all(
  NOTIFICATIONS.carriers.map(async (carrier) => ({
    label: carrier.label,
    file: carrier.file,
    icon: "terminal" as const,
    html: await highlightSource(carrier.code, carrier.lang),
    ariaLabel: `Notifications: ${carrier.label}`,
  })),
)

// The before-and-after figure's vendors, by service name.
const figureServices = catalog.services.map((s) => ({
  name: s.name,
  vendor: s.brand.vendor,
  logo: s.brand.logo,
}))

// The interactive example: its vendors and what each does for the app. The OAuth emulator's
// brand is the OpenID Foundation; name the protocol.
const example = APP_EXAMPLES.find((e) => e.slug === "medical-testing")
if (!example) throw new Error("medical-testing is missing from APP_EXAMPLES")
const ROLES: Record<string, { name?: string; role: string }> = {
  oauth: { name: "OAuth", role: "Google & Apple sign-in" },
  stripe: { role: "Payments" },
  junction: { role: "Lab results" },
  twilio: { role: "SMS" },
  resend: { role: "Email" },
  fcm: { role: "Push" },
  postgres: { role: "Database" },
}
const vendors = example.servicesUsed.map((name) => {
  const service = catalog.services.find((s) => s.name === name)
  if (!service) throw new Error(`${example.slug} uses ${name}, which is not in the catalog`)
  return {
    key: name,
    logo: service.brand.logo,
    name: ROLES[name]?.name ?? service.brand.vendor,
    role: ROLES[name]?.role ?? service.displayName,
  }
})

const categories = catalog.categories.map((category) => ({
  ...category,
  members: catalog.services
    .filter((service) => service.category === category.slug)
    .map((s) => ({ name: s.name, displayName: s.displayName, logo: s.brand.logo })),
}))
---

<Base>
  <Hero
    lead={HEADLINE.lead}
    accent={HEADLINE.accent}
    pitchHtml={inline(PITCH)}
    config={{ file: FLEET.configFile, configHtml: fleetConfigHtml, serveHtml: fleetServeHtml }}
  >
    <Fragment slot="install"><Install pkg={FLEET.package} /></Fragment>
  </Hero>

  <Stats services={totals.services} ops={totals.opsSupported} />

  <Section
    eyebrow="01 / Before and after"
    title="A test environment with nothing outside it."
    description="Tests that call live sandboxes wait on every vendor and fail when one is slow or down. Mockingbird runs an emulator of each service inside your process, so there is no network left to wait on."
  >
    <BeforeAfter services={figureServices} />
  </Section>

  <Section id="quick-start" eyebrow="02 / Quick start" title={FLEET.title} description={{ html: inline(FLEET.intro) }}>
    <div class="mb-4 max-w-4xl"><Install pkg={FLEET.packages.join(" ")} /></div>
    <CodePanels
      panels={[
        { label: "Declare", file: FLEET.configFile, icon: "file", html: fleetConfigHtml, ariaLabel: "Fleet configuration" },
        { label: "Start", file: "terminal", icon: "terminal", html: fleetServeHtml, ariaLabel: "Start the fleet" },
        { label: "Control", file: "terminal", icon: "terminal", html: fleetControlHtml, ariaLabel: "Control the fleet" },
      ]}
    />
    <FleetSteps steps={FLEET.steps.map((step) => ({ title: step.title, html: inline(step.body) }))} />
    <FeatureGrid features={FLEET.benefits.map((b) => ({ icon: b.icon, title: b.title, html: inline(b.body) }))} />
    <div class="mt-5 flex flex-wrap gap-2.5">
      <ButtonLink href="/docs/fleets" arrow>Fleets guide</ButtonLink>
      <ButtonLink href="/docs/getting-started" arrow>Getting started</ButtonLink>
    </div>
  </Section>

  <Section
    id="in-process"
    eyebrow="Or in-process, in a test"
    title="From product data to a paid order."
    description={{
      html: "When a test can hand the SDK a <code>fetch</code>, skip the ports. Build a checkout with PostgreSQL and Stripe emulators: seed the data, write an API against the unmodified Stripe SDK, and place an order from a client. Every step runs in your process.",
    }}
  >
    <div class="mb-4 max-w-4xl"><Install pkg={QUICK_START.packages.join(" ")} /></div>
    <QuickStartTabs client:visible steps={catalog.quickStart.steps} />
    <p class="mt-3.5 text-xs leading-relaxed text-muted">
      Save all three files next to the <code class="font-mono text-foreground">{QUICK_START.sdk}</code> SDK your app
      already has, then run <code class="font-mono text-foreground">bun client.ts</code> or
      <code class="font-mono text-foreground">npx tsx client.ts</code>.
      <TextLink href="/docs/getting-started#build-a-checkout" arrow className="ml-2 text-xs">Follow the walkthrough</TextLink>
    </p>
  </Section>

  <Section
    eyebrow="03 / Runtime controls"
    title="Reproducible behavior, with explicit coverage."
    description="Emulate the operations your application uses, inspect supported behavior, and control state between runs."
  >
    <FeatureGrid features={FEATURES.map((f) => ({ icon: f.icon, title: f.title, html: inline(f.body) }))} />
  </Section>

  <Section id="admin-controls" eyebrow="04 / Admin controls" title={ADMIN_CONTROLS.title} description={{ html: inline(ADMIN_CONTROLS.intro) }}>
    <div class="mb-7"><ControlDirectory /></div>
    <CodePanels panels={carriers} />
    <FeatureGrid
      features={ADMIN_CONTROLS.controls.map((control) => ({
        icon: control.icon,
        title: control.title,
        html: inline(control.body),
        href: `/docs/admin-controls/${guideSlug(control.page)}`,
        linkLabel: "Interface",
      }))}
    />
    <Callout icon="shield" title="Deterministic, down to the journal">
      <Html html={inline(ADMIN_CONTROLS.determinism)} />
      <Fragment slot="actions"><ButtonLink href="/docs/admin-controls" arrow>Admin controls guide</ButtonLink></Fragment>
    </Callout>
  </Section>

  <Section id="notifications" eyebrow="05 / Notifications" title={NOTIFICATIONS.title} description={{ html: inline(NOTIFICATIONS.intro) }}>
    <NotificationsDemo />
    <Devices channels={NOTIFICATIONS.channels} />
    <CodePanels panels={notificationCarriers} />
    <FeatureGrid
      features={NOTIFICATIONS.topics.map((topic) => ({
        icon: topic.icon,
        title: topic.title,
        html: inline(topic.body),
        href: `/docs/notifications/${guideSlug(topic.page)}`,
        linkLabel: "Read the page",
      }))}
    />
    <Callout icon="play" title="Watch a real app send them">
      The lab ordering example mounts the harness as its Notifications tab. Place an order and the receipt, the text and the push arrive, all inside this browser tab.
      <Fragment slot="actions">
        <ButtonLink href="/examples/medical-testing">Open the example</ButtonLink>
        <ButtonLink href="/docs/notifications" arrow>Notifications guide</ButtonLink>
      </Fragment>
    </Callout>
  </Section>

  <Section eyebrow="06 / Emulator catalog" title="Find your application's dependencies.">
    <Fragment slot="actions"><TextLink href="/services" arrow>All {totals.services} emulators</TextLink></Fragment>
    <FeaturedHeader />
    <div class="mt-5 mb-8"><ServiceGrid services={featured} /></div>
    <Categories categories={categories} />
  </Section>

  <Section
    eyebrow="07 / Interactive example"
    title="A complete application, running in your browser."
    description="The client, server, database emulator, and API emulators share one browser tab. Explore the application and its state without configuring a server."
  >
    <app-example data-example={example.slug} class="block min-w-0">
      <BrowserStack title={example.title} host={new URL(IDENTITY.docs).host} slug={example.slug} vendors={vendors} />
      <ExampleView title={example.title} fit="app" />
    </app-example>
  </Section>

  <Section eyebrow="08 / Service interface" title="A shared control plane for every HTTP emulator." description={{ html: inline(CONTRACT.intro) }}>
    <ContractTable rows={CONTRACT.rows.map(([surface, detail]) => [inline(surface), inline(detail)] as [string, string])} />
    <Html as="p" html={inline(CONTRACT.configNote)} className="mt-3.5 text-sm text-muted [&_a]:text-link [&_code]:font-mono [&_code]:text-[0.85em]" />
  </Section>

  <section class="pt-16">
    <AgentDocs html={inline(AGENTS)} />
  </section>
</Base>

<script>
  import "../client/appExamples.ts"
  import "../client/notificationsIsland.ts"
  import "../ui/landing/before-after.client.ts"
</script>
