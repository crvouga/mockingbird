{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/packages/service/*/README.md",
        "$TURBO_ROOT$/packages/service/*/DISCOVERY.md",
        "$TURBO_ROOT$/packages/service/*/SUPPORT.md",
        "$TURBO_ROOT$/packages/service/*/package.json",
        "$TURBO_ROOT$/docs/*.md",
        "$TURBO_ROOT$/llms.txt"
      ],
      "outputs": ["dist/**"]
    }
  }
}
