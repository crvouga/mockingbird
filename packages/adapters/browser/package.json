{
  "name": "@crvouga/mockingbird-adapter-browser",
  "version": "0.0.0-development",
  "description": "Browser runtime compatibility for whole-system previews: Node libraries, virtual files, Bun and Deno Fetch servers.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./net": {
      "types": "./dist/net.d.ts",
      "default": "./dist/net.js"
    },
    "./network/dns": {
      "types": "./dist/network/dns.d.ts",
      "default": "./dist/network/dns.js"
    },
    "./network/tls": {
      "types": "./dist/network/tls.d.ts",
      "default": "./dist/network/tls.js"
    },
    "./network/diagnostics-channel": {
      "types": "./dist/network/diagnostics-channel.d.ts",
      "default": "./dist/network/diagnostics-channel.js"
    },
    "./http2-unsupported": {
      "types": "./dist/http2-unsupported.d.ts",
      "default": "./dist/http2-unsupported.js"
    },
    "./http-client": {
      "types": "./dist/http-client.d.ts",
      "default": "./dist/http-client.js"
    },
    "./child-process-unsupported": {
      "types": "./dist/child-process-unsupported.d.ts",
      "default": "./dist/child-process-unsupported.js"
    }
  },
  "mockingbird": {
    "runtime": "portable",
    "layer": "adapter",
    "entries": {
      "build": "node"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "memfs": "4.80.1",
    "node-stdlib-browser": "1.3.1",
    "buffer": "6.0.3",
    "process": "0.11.10",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@playwright/test": "1.65.0",
    "pg": "8.23.0",
    "ioredis": "5.11.1",
    "express": "5.1.0",
    "@types/pg": "8.23.1",
    "@types/express": "5.0.3",
    "fastify": "5.6.2",
    "@nestjs/core": "11.1.9",
    "@nestjs/common": "11.1.9",
    "@nestjs/platform-fastify": "11.1.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "next": "15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@crvouga/mockingbird-service-fcm": "workspace:*",
    "@crvouga/mockingbird-service-postgres": "workspace:*",
    "@crvouga/mockingbird-service-redis": "workspace:*",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "esbuild": ">=0.28.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "TRANSPORT.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/adapters/browser"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/adapters/browser#readme"
}
