{
  "name": "@crvouga/mockingbird-preview",
  "version": "0.0.0-development",
  "description": "Portable worker preview hosts, streaming Fetch bridges, artifact verification and static preview lifecycle helpers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./dev-proxy": {
      "types": "./dist/dev-proxy.d.ts",
      "default": "./dist/dev-proxy.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/adapters/preview"
  },
  "mockingbird": {
    "runtime": "portable",
    "layer": "adapter",
    "entries": {
      "node": "node",
      "dev-proxy": "portable"
    }
  },
  "scripts": {
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "pack:check": "bun ../../../scripts/pack-check.ts",
    "portability": "bun ../../../scripts/portability.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2"
  }
}
