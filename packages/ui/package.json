{
  "name": "@crvouga/mockingbird-ui",
  "version": "0.0.0-development",
  "description": "Reusable browser system preview shell and CSS reset.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reset.css": {
      "types": "./dist/reset-css.d.ts",
      "default": "./src/reset.css"
    },
    "./system": {
      "types": "./dist/system-harness.d.ts",
      "default": "./dist/system-harness.js"
    },
    "./launcher": {
      "types": "./dist/preview-launcher.d.ts",
      "default": "./dist/preview-launcher.js"
    },
    "./freshness": {
      "types": "./dist/freshness-indicator.d.ts",
      "default": "./dist/freshness-indicator.js"
    }
  },
  "mockingbird": {
    "runtime": "portable",
    "layer": "ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "pack:check": "bun ../../scripts/pack-check.ts"
  },
  "files": [
    "dist",
    "README.md",
    "src/reset.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga-organization/mockingbird.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/crvouga-organization/mockingbird/tree/main/packages/ui#readme"
}
