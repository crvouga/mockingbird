{
  "name": "@crvouga/mockingbird-notifications",
  "version": "0.0.0-development",
  "description": "Notification test harness for Mockingbird fleets: every SMS, WhatsApp message, email, push and chat message your app sends through the Twilio, Resend, FCM, SES, SNS, Customer.io, Mailosaur and Slack emulators, on lifelike phone, mail and chat screens and a JSON API for tests.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    }
  },
  "bin": {
    "mockingbird-notifications": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/notifications"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/notifications#readme",
  "keywords": [
    "mockingbird",
    "notifications",
    "sms",
    "email",
    "push",
    "whatsapp",
    "slack",
    "chat",
    "testing"
  ],
  "mockingbird": {
    "runtime": "node",
    "layer": "tool"
  },
  "scripts": {
    "generate": "bun scripts/build-ui.ts",
    "build": "bun scripts/build-ui.ts && bun ../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "dev": "bun scripts/dev.ts",
    "pack:check": "bun ../../scripts/pack-check.ts",
    "portability": "bun ../../scripts/portability.ts",
    "storybook": "storybook dev -p 6007 --no-open",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "catalog:screenshots": "bun scripts/catalog-screenshots.ts",
    "e2e": "bun test ./e2e/ui.e2e.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-ses": "3.1001.0",
    "@aws-sdk/client-sns": "3.1001.0",
    "@crvouga/mockingbird-adapter-node": "workspace:*",
    "@crvouga/mockingbird-admin-ui": "workspace:*",
    "@crvouga/mockingbird-service-customerio": "workspace:*",
    "@crvouga/mockingbird-service-fcm": "workspace:*",
    "@crvouga/mockingbird-service-mailosaur": "workspace:*",
    "@crvouga/mockingbird-service-resend": "workspace:*",
    "@crvouga/mockingbird-service-ses": "workspace:*",
    "@crvouga/mockingbird-service-slack": "workspace:*",
    "@crvouga/mockingbird-service-sns": "workspace:*",
    "@crvouga/mockingbird-service-twilio": "workspace:*",
    "@playwright/test": "1.65.0",
    "@storybook/html-vite": "10.6.6",
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "storybook": "10.6.6",
    "vite": "8.3.7"
  }
}
