{
  "name": "@crvouga/mockingbird-kv-local-storage",
  "version": "0.1.0",
  "description": "KeyValueStore for Mockingbird on top of DOM Storage (localStorage / sessionStorage). Injected storage, SSR-safe, binary-safe.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/kv/local-storage"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/kv/local-storage#readme",
  "keywords": [
    "mockingbird",
    "kv",
    "localstorage"
  ],
  "mockingbird": {
    "runtime": "portable",
    "layer": "kv-adapter"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-kv": "^0.1.0"
  },
  "devDependencies": {
    "@crvouga/mockingbird-kv-properties": "^0.1.0",
    "@crvouga/mockingbird-testing": "^0.1.0",
    "fast-check": "4.9.0"
  }
}
