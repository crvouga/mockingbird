{
  "name": "mockingbird-lab-preview",
  "compatibility_date": "2026-11-13",
  // Serves /__dev/* (the dev proxy); everything else is a static file.
  "main": "src/worker.ts",
  "assets": {
    "directory": "./preview-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/__dev", "/__dev/*"]
  }
}
