{
  "name": "mockingbird-lab-preview",
  "compatibility_date": "2026-11-13",
  // Serves /__dev/* (the dev proxy) and /__preview/* (live CI status); everything else is a
  // static file.
  "main": "src/worker.ts",
  "assets": {
    "directory": "./preview-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/__dev", "/__dev/*", "/__preview/*"]
  },
  // One status object per preview Worker: the latest build/checks events and the open tabs'
  // WebSockets (hibernatable, so an idle tab costs nothing).
  "durable_objects": {
    "bindings": [{ "name": "PREVIEW_STATUS", "class_name": "PreviewStatus" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PreviewStatus"] }]
}
