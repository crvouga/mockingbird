{
  "name": "@crvouga/mockingbird-example-medical-testing",
  "version": "0.0.0-development",
  "private": true,
  "description": "A plain full-stack example. Sign in with an emailed code (Resend) or a Google or Apple OAuth emulator, verify a phone number with Twilio Verify, shop lab tests, pay with a Stripe Checkout emulator, and the paid order is fulfilled as a Junction lab order. Patients get receipts and order updates by email, SMS or WhatsApp and push through Resend, Twilio and FCM emulators, staff get Slack alerts, and everything is persisted to an in-process Postgres engine, in one process.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "mockingbird": {
    "runtime": "portable",
    "layer": "example"
  },
  "scripts": {
    "dev": "bun src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "build": "bun ../../../scripts/bundle-service.ts",
    "preview:build": "bun scripts/build-preview.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-notifications": "workspace:*",
    "@crvouga/mockingbird-service-fcm": "workspace:*",
    "@crvouga/mockingbird-service-junction": "workspace:*",
    "@crvouga/mockingbird-service-oauth": "workspace:*",
    "@crvouga/mockingbird-service-postgres": "workspace:*",
    "@crvouga/mockingbird-service-resend": "workspace:*",
    "@crvouga/mockingbird-service-slack": "workspace:*",
    "@crvouga/mockingbird-service-stripe": "workspace:*",
    "@crvouga/mockingbird-service-twilio": "workspace:*",
    "hono": "4.13.11",
    "htm": "3.1.1",
    "oauth4webapi": "3.8.8",
    "preact": "10.24.3",
    "@crvouga/mockingbird-ui": "workspace:*",
    "@crvouga/mockingbird-adapter-browser": "workspace:*"
  },
  "devDependencies": {
    "@crvouga/mockingbird-admin-ui": "workspace:*",
    "@types/bun": "1.4.0",
    "esbuild": "0.28.2"
  }
}
