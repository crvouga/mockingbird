{
  "name": "@crvouga/mockingbird-example-fleet-reference",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build entrypoint.ts --target=bun --outfile=dist/fleet.js",
