  },
  "dependencies": {
    "@crvouga/mockingbird-service-stripe": "workspace:*",
    "@crvouga/mockingbird-service-postgres": "workspace:*",
    "@crvouga/mockingbird-service-redis": "workspace:*"
  },
  "mockingbird": {
    "layer": "example",
    "runtime": "node"
  }
