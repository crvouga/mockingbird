{
  "name": "@crvouga/mockingbird-service-redis",
  "version": "0.0.0-development",
  "description": "In-process Redis RESP server for tests: strings, hashes, lists, sets, sorted sets, streams, transactions, pub/sub, and a Lua subset, with an injected clock. Not an HTTP emulator.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "SUPPORT.md",
    "DISCOVERY.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "mockingbird-redis": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/redis"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/redis#readme",
  "keywords": [
    "mockingbird",
    "redis",
    "resp",
    "emulator"
  ],
  "mockingbird": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "databases",
    "displayName": "Redis",
    "status": "wip",
    "vendor": {
      "website": "https://redis.io",
      "docs": "https://redis.io/docs/latest/commands/",
      "icon": "redis",
      "color": "#FF4438"
    },
    "parity": "RESP replies, expiration, transactions, and streams",
    "parityTier": "cold",
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Redis or Valkey selected by REDIS_URL",
        "command": "bun run --cwd packages/service/redis parity",
        "note": "The repository also differentially exercises BullMQ with parity:bullmq."
      },
      "introspection": [
        "README.md public test controls",
        "SUPPORT.md compatibility and divergence evidence"
      ],
      "reporting": "https://github.com/crvouga/mockingbird/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts",
    "parity:bullmq": "bun scripts/bullmq-parity.ts"
  },
  "devDependencies": {
    "@crvouga/mockingbird-adapter-node": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-credentials": "workspace:*",
    "bullmq": "5.76.2",
    "ioredis": "5.11.1",
    "ioredis-5-9": "npm:ioredis@5.9.2"
  }
}
