{
  "name": "@crvouga/mockingbird-service-stripe",
  "version": "0.0.0-development",
  "description": "Stateful mock of the Stripe API (customers, payments, subscriptions, invoices, checkout, webhooks) driven by its OpenAPI contract and verified by differential property tests against Stripe test mode.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/stripe"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/stripe#readme",
  "keywords": [
    "mockingbird",
    "service",
    "stripe"
  ],
  "mockingbird": {
    "runtime": "portable",
    "layer": "service"
  },
  "scripts": {
    "vendor": "bun scripts/vendor.ts",
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "mock:server": "bun scripts/server.ts",
    "client-parity": "bun scripts/client-parity.ts",
    "parity": "bun scripts/parity.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@crvouga/mockingbird-testing": "workspace:*",
    "@crvouga/mockingbird-adapter-bun": "workspace:*",
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "@crvouga/mockingbird-parity": "workspace:*",
    "@crvouga/mockingbird-openbao": "workspace:*",
    "stripe": "16.12.0",
    "yaml": "2.9.0",
    "@crvouga/mockingbird-openapi-codegen": "workspace:*",
    "@crvouga/mockingbird-openapi-metadata": "workspace:*",
    "@crvouga/mockingbird-core": "workspace:*",
    "@crvouga/mockingbird-sqlite": "workspace:*",
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-http-codec": "workspace:*",
    "@crvouga/mockingbird-commands": "workspace:*"
  }
}
