{
  "name": "@crvouga/mockingbird-service-stripe",
  "version": "0.1.0",
  "description": "Stateful mock of the Stripe API (customers, products, prices) driven by its OpenAPI contract and verified by differential property tests against Stripe test mode.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/stripe"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/stripe#readme",
  "keywords": [
    "mockingbird",
    "service",
    "stripe"
  ],
  "mockingbird": {
    "runtime": "portable",
    "layer": "service"
  },
  "scripts": {
    "vendor": "bun scripts/vendor.ts",
    "generate": "mockingbird-codegen",
    "generate:check": "mockingbird-codegen --check",
    "openapi:check": "mockingbird-codegen --validate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-core": "workspace:*",
    "@crvouga/mockingbird-sqlite": "workspace:*",
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-http-codec": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@crvouga/mockingbird-testing": "workspace:*",
    "@crvouga/sqlite-mem": "1.15.0",
    "@crvouga/mockingbird-parity": "workspace:*",
    "@crvouga/mockingbird-openbao": "workspace:*",
    "yaml": "2.9.0",
    "@crvouga/mockingbird-openapi-codegen": "workspace:*",
    "@crvouga/mockingbird-openapi-metadata": "workspace:*"
  }
}
