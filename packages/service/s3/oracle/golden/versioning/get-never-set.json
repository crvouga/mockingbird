[
  {
    "step": "get versioning",
    "request": "GET /ver-none-<run>?versioning=",
    "status": 200,
    "headers": {
      "accept-ranges": "bytes",
      "content-type": "application/xml",
      "x-amz-bucket-region": "us-east-1",
      "x-amz-id-2": "*",
      "x-amz-request-id": "*"
    },
    "body": "<VersioningConfiguration xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"></VersioningConfiguration>"
  },
  {
    "step": "get versioning missing bucket",
    "request": "GET /ver-nobucket-<run>?versioning=",
    "status": 404,
    "headers": {
      "accept-ranges": "bytes",
      "content-type": "application/xml",
      "x-amz-bucket-region": "us-east-1",
      "x-amz-id-2": "*",
      "x-amz-request-id": "*"
    },
    "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Error><Code>NoSuchBucket</Code><Message>The specified bucket does not exist</Message><BucketName>ver-nobucket-<run></BucketName><Resource>/ver-nobucket-<run></Resource><Region>us-east-1</Region><RequestId>*</RequestId><HostId>*</HostId></Error>"
  },
  {
    "step": "put versioning missing bucket",
    "request": "PUT /ver-nobucket2-<run>?versioning=",
    "status": 200,
    "headers": {
      "accept-ranges": "bytes",
      "content-length": "0",
      "x-amz-bucket-region": "us-east-1",
      "x-amz-id-2": "*",
      "x-amz-request-id": "*"
    },
    "body": ""
  }
]
