{
  "name": "@crvouga/mockingbird-service-s3",
  "version": "0.0.0-development",
  "description": "Stateful S3 emulator that answers exactly as MinIO does: every bucket, object, multipart, versioning, object-lock, policy and auth API, verified against recorded MinIO transcripts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "mockingbird-s3": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/s3"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/s3#readme",
  "keywords": [
    "mockingbird",
    "aws",
    "s3",
    "object-storage",
    "presigned-url",
    "emulator"
  ],
  "mockingbird": {
    "featured": true,
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "storage",
    "displayName": "Amazon S3",
    "vendor": {
      "website": "https://aws.amazon.com/s3/",
      "docs": "https://docs.aws.amazon.com/AmazonS3/latest/API/"
    },
    "parity": "Every MinIO S3 API, byte-exact against recorded MinIO transcripts",
    "parityTier": "cold",
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Pinned self-hosted MinIO (RELEASE.2025-10-15T17-29-55Z) and its recorded transcripts",
        "command": "bun run parity:service -- s3",
        "note": "bun test replays every recorded MinIO transcript against the emulator offline; the live run needs a MinIO you start (packages/service/s3/oracle/README.md) and exits 2 when it is unreachable."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/controls",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/mockingbird/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-sqlite": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/lib-storage": "3.1132.0",
    "@aws-sdk/s3-request-presigner": "3.1132.0",
    "@crvouga/mockingbird-adapter-node": "workspace:*",
    "@crvouga/mockingbird-core": "workspace:*",
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-openapi-codegen": "workspace:*",
    "@crvouga/mockingbird-openapi-metadata": "workspace:*",
    "@crvouga/mockingbird-parity": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-sqlite": "workspace:*",
    "@crvouga/mockingbird-testing": "workspace:*",
    "fast-check": "4.9.0"
  }
}
