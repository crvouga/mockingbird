{
  "name": "@crvouga/mockingbird-service",
  "version": "0.0.0-development",
  "private": true,
  "description": "Generic service runtime: Fetch-native APIs, Hono dispatch keyed by OpenAPI operationId, SQLite-backed collections, request parsing and operation registries.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/engine-admin.d.ts",
      "default": "./dist/engine-admin.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga-organization/mockingbird.git",
    "directory": "packages/service/core"
  },
  "homepage": "https://github.com/crvouga-organization/mockingbird/tree/main/packages/service/core#readme",
  "keywords": [
    "mockingbird",
    "service"
  ],
  "mockingbird": {
    "runtime": "portable",
    "layer": "service"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-admin-ui": "workspace:*",
    "@crvouga/mockingbird-core": "workspace:*",
    "@crvouga/mockingbird-http-codec": "workspace:*",
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-openapi-metadata": "workspace:*",
    "@crvouga/mockingbird-sqlite": "workspace:*",
    "@crvouga/mockingbird-ui": "workspace:*",
    "@gravity-ui/icons": "2.23.1",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "fast-xml-parser": "5.11.2",
    "hono": "4.13.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "@crvouga/mockingbird-testing": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.9.0"
  }
}
