{
  "name": "@crvouga/mockingbird-service-github",
  "version": "0.0.0-development",
  "description": "Stateful GitHub REST API 2026-03-10 mock for repository, reference and pull-request scenarios.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "API_EVIDENCE.md",
    "SUPPORT.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "mockingbird-github": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/github"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/github#readme",
  "keywords": [
    "mockingbird",
    "service",
    "github",
    "rest"
  ],
  "mockingbird": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "infrastructure",
    "displayName": "GitHub",
    "vendor": {
      "website": "https://github.com",
      "docs": "https://docs.github.com/en/rest",
      "description": "GitHub provides repository, Git reference and pull-request REST APIs."
    },
    "status": "wip"
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "@crvouga/mockingbird-parity": "workspace:*",
    "@crvouga/mockingbird-testing": "workspace:*",
    "@crvouga/mockingbird-openapi-codegen": "workspace:*",
    "@crvouga/mockingbird-core": "workspace:*",
    "@crvouga/mockingbird-sqlite": "workspace:*",
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-adapter-node": "workspace:*"
  }
}
