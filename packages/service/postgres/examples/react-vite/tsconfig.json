{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@crvouga/mockingbird-service-postgres": ["../../src/index.ts"],
      "@crvouga/mockingbird-ui/react/client": ["../../../../ui/src/react/client.tsx"],
      "@crvouga/mockingbird-ui/react": ["../../../../ui/src/react/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@heroui/react": ["./node_modules/@heroui/react"],
      "@heroui/styles": ["./node_modules/@heroui/styles"],
      "@gravity-ui/icons": ["./node_modules/@gravity-ui/icons"]
    }
  },
  "include": ["src", "scripts"]
}
