{
  "name": "@crvouga/mockingbird-service-aws-secrets",
  "version": "0.0.0-development",
  "description": "Stateful AWS Secrets Manager and SSM Parameter Store mock with versions, stages, rotation, and redacted controls.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "mockingbird-aws-secrets": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/aws-secrets"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/aws-secrets#readme",
  "keywords": [
    "mockingbird",
    "aws",
    "secrets-manager",
    "ssm",
    "parameter-store",
    "mock"
  ],
  "mockingbird": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "identity",
    "displayName": "AWS Secrets Manager & SSM",
    "status": "wip"
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-sqlite": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "3.1132.0",
    "@aws-sdk/client-ssm": "3.1132.0",
    "@crvouga/mockingbird-adapter-node": "workspace:*",
    "@crvouga/mockingbird-core": "workspace:*",
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-openapi-codegen": "workspace:*",
    "@crvouga/mockingbird-openapi-metadata": "workspace:*",
    "@crvouga/mockingbird-parity": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-sqlite": "workspace:*",
    "@crvouga/mockingbird-testing": "workspace:*",
    "fast-check": "4.9.0"
  }
}
