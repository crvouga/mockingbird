{
  "name": "@crvouga/mockingbird-service-google-calendar",
  "version": "0.0.0-development",
  "description": "Stateful mock of the Google Calendar v3 API and Google OAuth our EMR calls: events list/insert/update/delete/watch, channels.stop, calendarList/calendars, token exchange/refresh/revoke and userinfo, with signed-by-header push notifications.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "mockingbird-google-calendar": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/google-calendar"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/google-calendar#readme",
  "keywords": [
    "mockingbird",
    "service",
    "google-calendar",
    "googleapis",
    "oauth2",
    "calendar"
  ],
  "mockingbird": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "productivity",
    "displayName": "Google Calendar",
    "vendor": {
      "website": "https://workspace.google.com/products/calendar/",
      "docs": "https://developers.google.com/calendar/api/v3/reference"
    },
    "status": "wip"
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@crvouga/mockingbird-testing": "workspace:*",
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "@crvouga/mockingbird-parity": "workspace:*",
    "@crvouga/mockingbird-credentials": "workspace:*",
    "@crvouga/mockingbird-openapi-codegen": "workspace:*",
    "@crvouga/mockingbird-openapi-metadata": "workspace:*",
    "@crvouga/mockingbird-core": "workspace:*",
    "@crvouga/mockingbird-sqlite": "workspace:*",
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-http-codec": "workspace:*",
    "@crvouga/mockingbird-adapter-node": "workspace:*",
    "@googleapis/calendar": "9.8.0",
    "google-auth-library": "9.15.0"
  }
}
