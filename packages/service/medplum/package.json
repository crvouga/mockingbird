{
  "name": "@crvouga/mockingbird-service-medplum",
  "version": "0.0.0-development",
  "description": "Stateful Medplum mock that self-hosts the real Medplum server as a child process on embedded Postgres and Redis, exposed through the Mockingbird FetchAPI contract.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/medplum"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/medplum#readme",
  "keywords": [
    "mockingbird",
    "service",
    "medplum",
    "fhir"
  ],
  "mockingbird": {
    "runtime": "node",
    "layer": "service"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "embedded-postgres": "16.14.0-beta.17"
  },
  "devDependencies": {
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-openapi-codegen": "workspace:*",
    "@crvouga/mockingbird-openapi-metadata": "workspace:*",
    "@crvouga/mockingbird-parity": "workspace:*",
    "@crvouga/mockingbird-testing": "workspace:*",
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "fast-check": "4.9.0",
    "@crvouga/mockingbird-core": "workspace:*"
  }
}
