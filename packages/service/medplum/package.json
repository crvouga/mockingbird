{
  "name": "@crvouga/mockingbird-service-medplum",
  "version": "0.0.0-development",
  "description": "Stateful emulator of the self-hosted Medplum server (FHIR R4 REST, OAuth2 and admin API), proven at parity with a real self-hosted Medplum used as the oracle.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "NOTICE",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "mockingbird-medplum": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/medplum"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/medplum#readme",
  "keywords": [
    "mockingbird",
    "service",
    "medplum",
    "fhir",
    "fhir-r4",
    "ehr",
    "emulator"
  ],
  "mockingbird": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "health",
    "displayName": "Medplum",
    "vendor": {
      "website": "https://www.medplum.com",
      "docs": "https://www.medplum.com/docs",
      "description": "Medplum is an open-source, FHIR-native healthcare developer platform: a headless EHR backend, auth and SDKs."
    },
    "parity": "FHIR R4, OAuth, and admin",
    "parityTier": "cold",
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Pinned self-hosted Medplum",
        "command": "bun run parity:service -- medplum",
        "note": "The harness boots its own oracle (or accepts --oracle-url), compares scenarios and random walks, and keeps an oracle recording."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/controls",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/mockingbird/blob/main/docs/REPORTING_ISSUES.md"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js && bun scripts/generate-definitions.ts",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check && bun scripts/generate-definitions.ts --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "oracle": "bun scripts/oracle.ts",
    "oracle:record": "bun scripts/parity.ts --record",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "@medplum/core": "5.1.37",
    "@medplum/fhirtypes": "5.1.37",
    "dataloader": "2.2.3",
    "graphql": "17.0.2"
  },
  "devDependencies": {
    "@crvouga/mockingbird-adapter-node": "workspace:*",
    "@crvouga/mockingbird-core": "workspace:*",
    "@crvouga/mockingbird-http-codec": "workspace:*",
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-openapi-codegen": "workspace:*",
    "@crvouga/mockingbird-openapi-metadata": "workspace:*",
    "@crvouga/mockingbird-parity": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-sqlite": "workspace:*",
    "@crvouga/mockingbird-testing": "workspace:*",
    "@medplum/definitions": "5.1.37",
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "embedded-postgres": "16.14.0-beta.17",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "miniflare": "5.20261006.1-alpha"
  }
}
