{
  "name": "@crvouga/mockingbird-service-lifefile-v2",
  "version": "0.0.0-development",
  "description": "Stateful emulator of the LifeFile pharmacy API v2, matched to recorded sandbox replies: OAuth2 client-credentials tokens with idle expiry and secret rotation, order create with field-keyed validation and no deduplication, rx-UUID search, status writes with the fast-track cancel window, shipping updates, reference lists, privileges, and Basic-auth Data Push with a provisional payload.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DISCOVERY.md",
    "SUPPORT.md",
    "openapi.yaml"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "mockingbird-lifefile-v2": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/lifefile-v2"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/lifefile-v2#readme",
  "keywords": [
    "mockingbird",
    "service",
    "lifefile",
    "pharmacy",
    "compounding",
    "eRx",
    "data-push"
  ],
  "mockingbird": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "pharmacy",
    "displayName": "LifeFile API v2",
    "vendor": {
      "name": "LifeFile",
      "website": "https://www.lifefile.net",
      "description": "LifeFile provides pharmacy management software with an external order API and outbound Data Push."
    },
    "parity": "OAuth tokens, orders, statuses, shipping and Data Push (sandbox-recorded)",
    "parityTier": "cold",
    "discovery": {
      "guide": "DISCOVERY.md",
      "behavior": "README.md",
      "capabilities": "SUPPORT.md",
      "contract": "openapi.yaml",
      "types": "dist/index.d.ts",
      "oracle": {
        "kind": "Live vendor API or sandbox",
        "command": "bun run parity:service -- lifefile-v2",
        "note": "Run from a Mockingbird checkout; credentials come only from .env.local or GitHub Actions secrets. Missing credentials exit 2."
      },
      "introspection": [
        "GET /__admin/health",
        "GET /__admin",
        "GET /__admin/controls",
        "GET /__admin/state",
        "GET /__admin/requests",
        "GET /__admin/metrics",
        "GET /__admin/faults/presets",
        "GET /__admin/ui"
      ],
      "reporting": "https://github.com/crvouga/mockingbird/blob/main/docs/REPORTING_ISSUES.md"
    },
    "playground": {
      "headers": {
        "x-vendor-id": "10001"
      },
      "operation": "IssueToken"
    }
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts",
    "soak": "bun scripts/soak.ts --minutes 30",
    "soak:long": "bun scripts/soak.ts --minutes 360",
    "corpus": "bun scripts/record-corpus.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-runtime": "workspace:*",
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "hono": "4.13.11"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@crvouga/mockingbird-testing": "workspace:*",
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "@crvouga/mockingbird-parity": "workspace:*",
    "@crvouga/mockingbird-credentials": "workspace:*",
    "@crvouga/mockingbird-openapi-codegen": "workspace:*",
    "@crvouga/mockingbird-openapi-metadata": "workspace:*",
    "@crvouga/mockingbird-core": "workspace:*",
    "@crvouga/mockingbird-sqlite": "workspace:*",
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-http-codec": "workspace:*",
    "@crvouga/mockingbird-adapter-node": "workspace:*"
  }
}
