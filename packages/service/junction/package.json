{
  "name": "@crvouga/mockingbird-service-junction",
  "version": "0.0.0-development",
  "description": "Stateful mock of the Junction (Vital) user API driven by its OpenAPI contract and verified by differential property tests against the Junction sandbox.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./corpus": {
      "types": "./dist/corpus.d.ts",
      "default": "./dist/corpus.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "mockingbird-junction": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/junction"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/junction#readme",
  "keywords": [
    "mockingbird",
    "service",
    "junction",
    "vital"
  ],
  "mockingbird": {
    "runtime": "portable",
    "entries": {
      "server": "node",
      "cli": "node"
    },
    "layer": "service",
    "category": "health",
    "displayName": "Junction"
  },
  "scripts": {
    "generate": "bun ../../openapi/codegen/dist/cli.js",
    "generate:check": "bun ../../openapi/codegen/dist/cli.js --check",
    "openapi:check": "bun ../../openapi/codegen/dist/cli.js --validate",
    "build": "bun ../../../scripts/bundle-service.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "parity": "bun scripts/parity.ts",
    "mock:server": "bun scripts/server.ts",
    "mock:serve": "bun scripts/server.ts",
    "corpus:record": "bun scripts/record-corpus.ts",
    "client-parity": "bun scripts/client-parity.ts",
    "client-parity:live": "JUNCTION_LIVE_PARITY=1 bun scripts/client-parity-live.ts",
    "webhook:dev": "wrangler dev --config webhook-receiver/wrangler.jsonc",
    "webhook:deploy": "wrangler deploy --config webhook-receiver/wrangler.jsonc",
    "webhook:register": "bun scripts/register-webhook.ts",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts",
    "verify": "bun src/cli.ts verify"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "hono": "4.11.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@crvouga/mockingbird-openapi-codegen": "workspace:*",
    "@crvouga/mockingbird-adapter-node": "workspace:*",
    "@crvouga/mockingbird-openapi-metadata": "workspace:*",
    "@crvouga/mockingbird-openbao": "workspace:*",
    "@crvouga/mockingbird-testing": "workspace:*",
    "@crvouga/mockingbird-service-sqlite": "workspace:*",
    "@tryvital/vital-node": "3.1.511",
    "fast-check": "4.9.0",
    "wrangler": "^4.129.1",
    "@crvouga/mockingbird-core": "workspace:*",
    "@crvouga/mockingbird-sqlite": "workspace:*",
    "@crvouga/mockingbird-openapi": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-http-codec": "workspace:*",
    "@crvouga/mockingbird-commands": "workspace:*",
    "@crvouga/mockingbird-parity": "workspace:*"
  }
}
