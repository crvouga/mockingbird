{
  "name": "@crvouga/mockingbird-service-junction",
  "version": "0.1.0",
  "description": "Stateful mock of the Junction (Vital) API driven by its OpenAPI contract and verified by differential property tests against the Junction sandbox.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/mockingbird.git",
    "directory": "packages/service/junction"
  },
  "homepage": "https://github.com/crvouga/mockingbird/tree/main/packages/service/junction#readme",
  "keywords": [
    "mockingbird",
    "service",
    "junction"
  ],
  "mockingbird": {
    "runtime": "portable",
    "layer": "service"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "portability": "bun ../../../scripts/portability.ts",
    "pack:check": "bun ../../../scripts/pack-check.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-kv": "workspace:*",
    "@crvouga/mockingbird-service": "workspace:*",
    "@crvouga/mockingbird-http-codec": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "@crvouga/mockingbird-testing": "workspace:*",
    "@crvouga/mockingbird-kv-memory": "workspace:*",
    "@crvouga/mockingbird-parity": "workspace:*",
    "@crvouga/mockingbird-openbao": "workspace:*"
  }
}
