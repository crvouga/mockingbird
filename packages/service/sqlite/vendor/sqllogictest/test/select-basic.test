# Basic SELECT / INSERT / WHERE — trimmed SQLLogicTest records
# Derived from the public SQLLogicTest format (sqlite.org/sqllogictest).

statement ok
CREATE TABLE t1(a INTEGER, b INTEGER, c INTEGER)

statement ok
INSERT INTO t1(a,b,c) VALUES(1,2,3)

statement ok
INSERT INTO t1(a,b,c) VALUES(4,5,6)

query III nosort
SELECT a,b,c FROM t1 ORDER BY a
----
1 2 3
4 5 6

query I nosort
SELECT a FROM t1 WHERE b > 3 ORDER BY a
----
4

query I nosort
SELECT count(*) FROM t1
----
2

statement ok
CREATE TABLE t2(x TEXT, y INTEGER)

statement ok
INSERT INTO t2 VALUES('hello', 1)

statement ok
INSERT INTO t2 VALUES('world', 2)

query TI nosort
SELECT x, y FROM t2 ORDER BY y
----
hello 1
world 2

query I nosort
SELECT a + b FROM t1 WHERE a = 1
----
3

statement ok
CREATE TABLE t3(id INTEGER PRIMARY KEY, v TEXT)

statement ok
INSERT INTO t3 VALUES(1, 'a')

statement ok
INSERT INTO t3 VALUES(2, 'b')

query IT nosort
SELECT id, v FROM t3 WHERE id IN (SELECT id FROM t3 WHERE v = 'a')
----
1 a

query I nosort
SELECT a FROM t1 UNION SELECT y FROM t2 ORDER BY 1
----
1
2
4
