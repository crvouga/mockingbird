{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "biome.json"],
  "globalEnv": ["CI", "GITHUB_ACTIONS", "WEBHOOK_DB", "WEBHOOK_READ_TOKEN"],
  "tasks": {
    "generate": {
      "dependsOn": ["^build"],
      "inputs": ["openapi.yaml", "codegen.json"],
      "outputs": ["src/generated/**", "SUPPORT.md"]
    },
    "generate:check": {
      "dependsOn": ["^build"],
      "inputs": ["openapi.yaml", "codegen.json", "src/generated/**", "SUPPORT.md"]
    },
    "openapi:check": {
      "dependsOn": ["^build"],
      "inputs": ["openapi.yaml"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!README.md"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "env": [
        "FC_SEED",
        "FC_NUM_RUNS",
        "MOCKINGBIRD_MAX_COMMANDS",
        "MOCKINGBIRD_TRACE",
        "MOCKINGBIRD_MEDPLUM_ORACLE",
        "MOCKINGBIRD_MEDPLUM_ORACLE_URL",
        "MOCKINGBIRD_MEDPLUM_VERSION",
        "MEDPLUM_MOCK_CACHE_DIR"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": []
    },
    "portability": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!README.md",
        "$TURBO_ROOT$/scripts/portability.ts"
      ]
    },
    "pack:check": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "$TURBO_ROOT$/scripts/pack-check.ts"]
    },
    "parity": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "MOCKINGBIRD_*",
        "FC_SEED",
        "FC_NUM_RUNS",
        "MOCKINGBIRD_MAX_COMMANDS",
        "MOCKINGBIRD_TRACE",
        "STRIPE_SECRET_KEY",
        "JUNCTION_API_KEY",
        "GENEBYGENE_CLIENT_ID",
        "GENEBYGENE_CLIENT_SECRET",
        "MOCKINGBIRD_STRIPE_BASE_URL",
        "MOCKINGBIRD_JUNCTION_BASE_URL",
        "MOCKINGBIRD_WEBHOOK_READ_TOKEN",
        "MOCKINGBIRD_JUNCTION_WEBHOOK_RECEIVER_URL",
        "MOCKINGBIRD_GENEBYGENE_BASE_URL",
        "MOCKINGBIRD_GENEBYGENE_TOKEN_URL"
      ]
    },
    "//#check:boundaries": {
      "inputs": [
        "scripts/check-boundaries.ts",
        "scripts/lib/**",
        "packages/*/package.json",
        "packages/*/*/package.json",
        "packages/**/src/**/*.ts",
        "!packages/**/node_modules/**",
        "!packages/**/dist/**"
      ]
    },
    "//#check:agents": {
      "cache": false
    },
    "//#check:llms": {
      "inputs": [
        "llms.txt",
        "scripts/llms-txt.ts",
        "scripts/release/lib.ts",
        "sites/docs/src/lib/**",
        "packages/**/package.json",
        "!packages/**/node_modules/**"
      ]
    },
    "//#check:brands": {
      "inputs": [
        "scripts/brands.ts",
        "scripts/release/lib.ts",
        "sites/docs/src/data/brands.json",
        "sites/docs/public/brands/**",
        "packages/**/package.json",
        "!packages/**/node_modules/**"
      ]
    },
    "//#check:readme": {
      "inputs": [
        "README.md",
        "scripts/readme.ts",
        "scripts/release/lib.ts",
        "sites/docs/src/lib/**",
        "docs/*.md",
        "packages/**/package.json",
        "!packages/**/node_modules/**"
      ]
    },
    "//#check:format": {
      "inputs": ["biome.json", "scripts/**", "docs/**", "*.json", "*.md", ".github/**"]
    }
  }
}
