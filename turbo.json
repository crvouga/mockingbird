{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["CI", "GITHUB_ACTIONS", "WEBHOOK_DB", "WEBHOOK_READ_TOKEN"],
  "tasks": {
    "generate": {
      "dependsOn": ["^build"],
      "inputs": ["openapi.yaml", "codegen.json"],
      "outputs": ["src/generated/**", "SUPPORT.md"]
    },
    "generate:check": {
      "dependsOn": ["^build"],
      "inputs": ["openapi.yaml", "codegen.json", "src/generated/**", "SUPPORT.md"]
    },
    "openapi:check": {
      "dependsOn": ["^build"],
      "inputs": ["openapi.yaml"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!README.md"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "env": [
        "FC_SEED",
        "FC_NUM_RUNS",
        "MOCKINGBIRD_MAX_COMMANDS",
        "MOCKINGBIRD_TRACE",
        "MOCKINGBIRD_MEDPLUM_ORACLE",
        "MOCKINGBIRD_MEDPLUM_ORACLE_URL",
        "MOCKINGBIRD_MEDPLUM_VERSION",
        "MEDPLUM_MOCK_CACHE_DIR"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": []
    },
    "portability": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!README.md",
        "$TURBO_ROOT$/scripts/portability.ts"
      ]
    },
    "pack:check": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "$TURBO_ROOT$/scripts/pack-check.ts"]
    },
    "parity": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "FC_SEED",
        "FC_NUM_RUNS",
        "MOCKINGBIRD_MAX_COMMANDS",
        "MOCKINGBIRD_TRACE",
        "WEBHOOK_READ_TOKEN",
        "GENE_BY_GENE_*",
        "AHA_*",
        "AWS_SPEECH_*",
        "BEDROCK_*",
        "CARETALK_*",
        "CUSTOMERIO_*",
        "DAILY_*",
        "EASYPOST_*",
        "EDAMAM_*",
        "FIRSTPROMOTER_*",
        "FLEX_*",
        "FORMBRICKS_*",
        "FULLSCRIPT_*",
        "GENEBYGENE_*",
        "GOOGLE_CALENDAR_*",
        "GOOGLE_MAPS_*",
        "HEALTHIE_*",
        "INTERCOM_*",
        "JUNCTION_*",
        "KLAVIYO_*",
        "LLAMACLOUD_*",
        "MAILOSAUR_*",
        "ODX_*",
        "OTEL_*",
        "PAYLOAD_CMS_*",
        "PERSONA_*",
        "PHARMETIKA_*",
        "PLANE_*",
        "POSTHOG_*",
        "PRISM_*",
        "RESEND_*",
        "RXVORTEX_*",
        "SLACK_*",
        "STRIPE_*",
        "TWILIO_*",
        "VPI_*",
        "WHOLESCRIPTS_*"
      ]
    },
    "//#check:boundaries": {
      "inputs": [
        "scripts/check-boundaries.ts",
        "scripts/lib/**",
        "packages/*/package.json",
        "packages/*/*/package.json",
        "packages/**/src/**/*.ts",
        "!packages/**/node_modules/**",
        "!packages/**/dist/**"
      ]
    },
    "//#check:agents": {
      "cache": false
    },
    "//#check:worktree": {
      "inputs": ["scripts/worktree/**", ".superset/config.json", ".super.engineering/config.json"]
    },
    "//#check:parity-tiers": {
      "inputs": ["scripts/parity-tiers.ts", "packages/service/*/package.json"]
    },
    "//#check:service-discovery": {
      "inputs": [
        "scripts/service-discovery.ts",
        "packages/service/*/package.json",
        "packages/service/*/README.md",
        "packages/service/*/DISCOVERY.md",
        "packages/service/*/SUPPORT.md",
        "packages/service/*/COMPATIBILITY.md",
        "packages/service/*/openapi.yaml"
      ]
    },
    "//#check:llms": {
      "inputs": [
        "llms.txt",
        "scripts/llms-txt.ts",
        "scripts/release/lib.ts",
        "sites/docs/src/lib/**",
        "packages/**/package.json",
        "!packages/**/node_modules/**"
      ]
    },
    "//#check:brands": {
      "inputs": [
        "scripts/brands.ts",
        "scripts/release/lib.ts",
        "sites/docs/src/data/brands.json",
        "sites/docs/public/brands/**",
        "packages/**/package.json",
        "!packages/**/node_modules/**"
      ]
    },
    "//#check:readme": {
      "inputs": [
        "README.md",
        "scripts/readme.ts",
        "scripts/release/lib.ts",
        "sites/docs/src/lib/**",
        "docs/*.md",
        "packages/**/package.json",
        "!packages/**/node_modules/**"
      ]
    },
    "//#check:scripts": {
      "inputs": [
        "scripts/**",
        "packages/adapters/node/src/fleet-manifest.ts",
        "tsconfig.base.json",
        "package.json",
        "bun.lock"
      ]
    },
    "//#check:workflows": {
      "inputs": [".github/workflows/**", ".github/actions/**", "scripts/check-workflows.ts"]
    },
    "//#check:format": {
      "inputs": ["biome.json", "scripts/**", "docs/**", "*.json", "*.md", ".github/**"]
    },
    "//#health:npm": {
      "cache": false,
      "passThroughEnv": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_HOST",
        "GH_CONFIG_DIR",
        "MOCKINGBIRD_HEALTH_REPORT_DIR",
        "MOCKINGBIRD_HEALTH_INTERACTIVE"
      ]
    },
    "//#health:trusted-publisher": {
      "cache": false,
      "passThroughEnv": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_HOST",
        "GH_CONFIG_DIR",
        "MOCKINGBIRD_HEALTH_REPORT_DIR",
        "MOCKINGBIRD_HEALTH_INTERACTIVE"
      ]
    },
    "//#health:github": {
      "cache": false,
      "passThroughEnv": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_HOST",
        "GH_CONFIG_DIR",
        "MOCKINGBIRD_HEALTH_REPORT_DIR",
        "MOCKINGBIRD_HEALTH_INTERACTIVE"
      ]
    },
    "//#health:secrets": {
      "cache": false,
      "passThroughEnv": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_HOST",
        "GH_CONFIG_DIR",
        "MOCKINGBIRD_HEALTH_REPORT_DIR",
        "MOCKINGBIRD_HEALTH_INTERACTIVE"
      ]
    },
    "//#health:docs": {
      "cache": false,
      "passThroughEnv": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_HOST",
        "GH_CONFIG_DIR",
        "MOCKINGBIRD_HEALTH_REPORT_DIR",
        "MOCKINGBIRD_HEALTH_INTERACTIVE"
      ]
    },
    "//#health:images": {
      "cache": false,
      "passThroughEnv": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_HOST",
        "GH_CONFIG_DIR",
        "MOCKINGBIRD_HEALTH_REPORT_DIR",
        "MOCKINGBIRD_HEALTH_INTERACTIVE"
      ]
    },
    "//#health:repository": {
      "cache": false,
      "passThroughEnv": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_HOST",
        "GH_CONFIG_DIR",
        "MOCKINGBIRD_HEALTH_REPORT_DIR",
        "MOCKINGBIRD_HEALTH_INTERACTIVE"
      ]
    },
    "//#health:all": {
      "cache": false,
      "dependsOn": [
        "//#health:npm",
        "//#health:trusted-publisher",
        "//#health:github",
        "//#health:secrets",
        "//#health:docs",
        "//#health:images",
        "//#health:repository"
      ],
      "passThroughEnv": ["MOCKINGBIRD_HEALTH_REPORT_DIR"]
    }
  }
}
