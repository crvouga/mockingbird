# Local-only values. Copy to .env.local (bun run setup does it); Bun loads .env.local
# automatically. Never commit values: .env.local is gitignored.
#
# None of this is needed to build, test, or run `bun run check`.
#
# Live parity keys are GitHub Actions repo secrets with these same names. With write access
# to the repo you can use them without having them: `bun run parity:remote -- <service>`.
# Fill in your own sandbox keys here only to run parity locally
# (`bun run parity:service -- <service>`), and `bun run secrets:push -- --yes` uploads the
# ones you set. `bun run secrets:doctor` shows what is configured where. See docs/SECRETS.md.

# Optional: resolve GitGuardian false positives from the CLI (bun run pr:merge guardian ignore)
GITGUARDIAN_API_KEY=

# aha
MOCKINGBIRD_AHA_API_URL=
MOCKINGBIRD_AHA_API_KEY=
MOCKINGBIRD_AHA_API_SECRET=

# aws-speech
MOCKINGBIRD_AWS_SPEECH_ACCESS_KEY_ID=
MOCKINGBIRD_AWS_SPEECH_SECRET_ACCESS_KEY=
MOCKINGBIRD_AWS_SPEECH_REGION=

