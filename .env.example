# Env var names this repo reads — no values. All live in Vault secret/personal/<config>
# (see docs/SECRETS.md); `vault run` / scripts/vault-run.ts injects them. Never commit values.

# Turborepo remote cache (dev + prd; CI loads them via Vault GitHub OIDC)
TURBO_API=
TURBO_TOKEN=
TURBO_TEAM=
TURBO_CACHE=
TURBO_LOG_ORDER=
TURBO_TELEMETRY_DISABLED=

# Live parity sandbox keys (personal/prd; `bun run parity*` uses `vault run --config prd`)
MOCKINGBIRD_STRIPE_SECRET_KEY=
MOCKINGBIRD_STRIPE_PUBLISHABLE_KEY=
MOCKINGBIRD_JUNCTION_API_KEY=
MOCKINGBIRD_GENEBYGENE_CLIENT_ID=
MOCKINGBIRD_GENEBYGENE_CLIENT_SECRET=

# Release (optional; only to create brand-new npm packages — else `bun run release:seed`)
NPM_TOKEN=
