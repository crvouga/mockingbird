{
  "name": "mockingbird-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "packages/core",
    "packages/facade",
    "packages/testing",
    "packages/sqlite",
    "packages/http/*",
    "packages/openapi/*",
    "packages/parity/*",
    "packages/service/*",
    "packages/adapters/*",
    "packages/auth/*"
  ],
  "trustedDependencies": [
    "embedded-postgres",
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-ia32",
    "@embedded-postgres/linux-ppc64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/windows-x64",
    "redis-memory-server"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "check": "turbo run lint typecheck openapi:check generate:check build test portability pack:check check:boundaries check:agents check:llms check:format",
    "check:full": "bun scripts/ci-local.ts",
    "pack:check": "turbo run pack:check",
    "portability": "turbo run portability",
    "pr:ready": "bun scripts/pr-ready.ts",
    "parity": "turbo run parity --filter=@crvouga/mockingbird-service-junction --concurrency=1",
    "parity:stripe": "turbo run parity --filter=@crvouga/mockingbird-service-stripe",
    "parity:junction": "turbo run parity --filter=@crvouga/mockingbird-service-junction",
    "parity:genebygene": "turbo run parity --filter=@crvouga/mockingbird-service-genebygene",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:agents": "bun scripts/agent-commands.ts --check",
    "agents:sync": "bun scripts/agent-commands.ts",
    "check:llms": "bun scripts/llms-txt.ts --check",
    "llms:sync": "bun scripts/llms-txt.ts",
    "check:format": "biome format .",
    "format": "biome format --write .",
    "prepare": "husky",
    "gh": "open https://github.com/crvouga/mockingbird/actions",
    "release:plan": "bun scripts/release/plan.ts",
    "release:publish": "bun scripts/release/publish.ts",
    "release:smoke": "bun scripts/release/consumer-smoke.ts",
    "release:seed": "bun scripts/release/seed.ts",
    "npm": "open https://www.npmjs.com/package/@crvouga/mockingbird",
    "vault:login": "bun scripts/vault-login.ts",
    "secrets:doctor": "bun scripts/secrets/doctor.ts",
    "secrets:check": "bun scripts/secrets/check-vault.ts",
    "secrets:sync": "bun scripts/secrets/sync-github.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "husky": "^9.1.7",
    "publint": "^0.3.23",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
