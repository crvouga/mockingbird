{
  "name": "mockingbird-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "packages/core",
    "packages/testing",
    "packages/ui",
    "packages/admin-ui",
    "packages/sqlite",
    "packages/webhook-collector",
    "packages/http/*",
    "packages/mqtt/*",
    "packages/openapi/*",
    "packages/parity/*",
    "packages/service/*",
    "packages/examples/*",
    "packages/adapters/*",
    "packages/auth/*",
    "sites/docs"
  ],
  "trustedDependencies": [
    "embedded-postgres",
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-ia32",
    "@embedded-postgres/linux-ppc64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/windows-x64"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "check": "turbo run lint typecheck openapi:check generate:check build test portability pack:check check:boundaries check:agents check:worktree check:llms check:readme check:brands check:parity-tiers check:service-discovery check:performance check:scripts check:workflows check:format",
    "check:full": "bun scripts/ci-local.ts",
    "pack:check": "turbo run pack:check",
    "portability": "turbo run portability",
    "pr:ready": "bun scripts/pr-ready.ts",
    "parity": "turbo run parity --filter=@crvouga/mockingbird-service-junction --concurrency=1",
    "parity:stripe": "turbo run parity --filter=@crvouga/mockingbird-service-stripe",
    "parity:stripe:webhooks": "bun packages/service/stripe/scripts/webhook-smoke.ts",
    "parity:junction": "turbo run parity --filter=@crvouga/mockingbird-service-junction",
    "parity:genebygene": "turbo run parity --filter=@crvouga/mockingbird-service-genebygene",
    "parity:twilio": "turbo run parity --filter=@crvouga/mockingbird-service-twilio",
    "parity:service": "bun scripts/parity-service.ts",
    "parity:remote": "bun scripts/parity-remote.ts",
    "github:resolve-issues": "bun scripts/resolve-issues.ts dispatch",
    "verify:junction": "bun run --cwd packages/service/junction verify -- --sample 60 --orders",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:agents": "bun scripts/agent-commands.ts --check",
    "agents:sync": "bun scripts/agent-commands.ts",
    "check:worktree": "bun scripts/worktree/sync.ts --check",
    "worktree:sync": "bun scripts/worktree/sync.ts",
    "check:llms": "bun scripts/llms-txt.ts --check",
    "llms:sync": "bun scripts/llms-txt.ts",
    "check:readme": "bun scripts/readme.ts --check",
    "check:brands": "bun scripts/brands.ts --check",
    "check:parity-tiers": "bun scripts/parity-tiers.ts --check",
    "service:discovery": "bun scripts/service-discovery.ts",
    "check:service-discovery": "bun scripts/service-discovery.ts --check",
    "parity:tiers": "bun scripts/parity-tiers.ts list",
    "brands:sync": "bun scripts/brands.ts",
    "readme:sync": "bun scripts/readme.ts",
    "check:scripts": "tsc -p scripts/tsconfig.json && bun test ./scripts",
    "check:workflows": "bun scripts/check-workflows.ts",
    "check:format": "biome format .",
    "format": "biome format --write .",
    "docs": "bun run docs:dev",
    "docs:dev": "turbo run build --filter=@crvouga/mockingbird-docs^... && bun scripts/docs-dev.ts --ignore-lock --port ${MOCKINGBIRD_DOCS_PORT:-4321} --host 127.0.0.1",
    "docs:build": "turbo run build --filter=@crvouga/mockingbird-docs...",
    "docs:preview": "bun run docs:build && bun run --cwd sites/docs preview",
    "prepare": "husky",
    "gh": "open https://github.com/crvouga/mockingbird/actions",
    "release:plan": "bun scripts/release/plan.ts",
    "release:publish": "bun scripts/release/publish.ts",
    "release:smoke": "bun scripts/release/consumer-smoke.ts",
    "release:seed": "bun scripts/release/seed.ts",
    "npm": "open https://www.npmjs.com/package/@crvouga/mockingbird",
    "health": "bun scripts/health/cli.ts",
    "secrets": "bun scripts/secrets/cli.ts",
    "secrets:doctor": "bun scripts/secrets/doctor.ts",
    "secrets:push": "bun scripts/secrets/push-env.ts",
    "health:npm": "bun scripts/health/task.ts npm",
    "health:trusted-publisher": "bun scripts/health/task.ts trusted-publisher",
    "health:github": "bun scripts/health/task.ts github",
    "health:secrets": "bun scripts/health/task.ts secrets",
    "health:docs": "bun scripts/health/task.ts docs",
    "health:images": "bun scripts/health/task.ts images",
    "health:repository": "bun scripts/health/task.ts repository",
    "health:all": "bun scripts/health/task.ts --summary",
    "performance": "bun scripts/performance/run.ts --check",
    "performance:profile": "bun scripts/performance/profile.ts",
    "check:performance": "bun scripts/performance/run.ts --check",
    "performance:browser": "turbo run build --filter=@crvouga/mockingbird-service-sqlite --filter=@crvouga/mockingbird-service-postgres && bun scripts/performance/browser.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-acm": "3.1132.0",
    "@aws-sdk/client-api-gateway": "3.1132.0",
    "@aws-sdk/client-cloudcontrol": "3.1132.0",
    "@aws-sdk/client-cloudformation": "3.1132.0",
    "@aws-sdk/client-cloudwatch": "3.1132.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1132.0",
    "@aws-sdk/client-config-service": "3.1132.0",
    "@aws-sdk/client-dynamodb-streams": "3.1132.0",
    "@aws-sdk/client-ec2": "3.1132.0",
    "@aws-sdk/client-elasticsearch-service": "3.1132.0",
    "@aws-sdk/client-eventbridge": "3.1132.0",
    "@aws-sdk/client-firehose": "3.1132.0",
    "@aws-sdk/client-iam": "3.1132.0",
    "@aws-sdk/client-kinesis": "3.1132.0",
    "@aws-sdk/client-kms": "3.1132.0",
    "@aws-sdk/client-lambda": "3.1132.0",
    "@aws-sdk/client-opensearch": "3.1132.0",
    "@aws-sdk/client-redshift": "3.1132.0",
    "@aws-sdk/client-resource-groups": "3.1132.0",
    "@aws-sdk/client-resource-groups-tagging-api": "3.1132.0",
    "@aws-sdk/client-route-53": "3.1132.0",
    "@aws-sdk/client-route53resolver": "3.1132.0",
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/client-s3-control": "3.1132.0",
    "@aws-sdk/client-scheduler": "3.1132.0",
    "@aws-sdk/client-ses": "3.1132.0",
    "@aws-sdk/client-sns": "3.1132.0",
    "@aws-sdk/client-sqs": "3.1132.0",
    "@aws-sdk/client-ssm": "3.1132.0",
    "@aws-sdk/client-sts": "3.1132.0",
    "@aws-sdk/client-support": "3.1132.0",
    "@aws-sdk/client-swf": "3.1132.0",
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "publint": "^0.3.24",
    "rollup": "4.63.4",
    "rollup-plugin-dts": "6.5.1",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
